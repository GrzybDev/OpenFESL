{#def rules, look, roster, name: str, refused: str, from_game: bool, kits: dict, slot: int, figure: dict | None #}
{# The one-screen creator: the hero on the stage at the left, the faction, class and look on the
   wooden panel at the right, and the naming step. Without scripts every list shows, the naming
   is the form's last part, and the name is checked when the form is sent. #}
{% set faction = rules.factions[look.faction] %}
{% set hair = faction.place(look.hair_style) %}
{% set beard = faction.place(look.facial_hair) %}
{% set who = {} %}
{% for faction_id in rules.factions %}
  {% for class_id in rules.classes %}
    {% set kept = who.update({faction_id ~ "." ~ class_id: _("web.creator.who", hero_class=_("games." ~ game.id ~ ".class." ~ class_id), faction=_("games." ~ game.id ~ ".faction." ~ faction_id))}) %}
  {% endfor %}
{% endfor %}
{% set current = look.faction ~ "." ~ look.hero_class %}
{% set factions = {} %}
{% set glyphs = {} %}
{% for faction_id, choice in rules.factions.items() %}
  {% set kept = factions.update({faction_id: _("games." ~ game.id ~ ".faction." ~ faction_id)}) %}
  {% set kept = glyphs.update({faction_id: static("icons.svg") ~ "#" ~ choice.glyph}) %}
{% endfor %}
{% set classes = {} %}
{% for class_id, choice in rules.classes.items() %}
  {% set kept = classes.update({class_id: static("icons.svg") ~ "#" ~ choice.glyph}) %}
{% endfor %}
{# The texts the page's script fills in, their placeholders kept for it. #}
{% set texts = {
  "who": who,
  "bubble_who": _("web.creator.bubble.who", who="%(who)s"),
  "look": _("web.creator.figure", skin="%(skin)s", hair_colour="%(hair_colour)s", hair="%(hair)s", beard="%(beard)s"),
  "model_label": _("web.creator.model", who="%(who)s", skin="%(skin)s", hair_colour="%(hair_colour)s", hair="%(hair)s", beard="%(beard)s"),
  "hair": _("web.creator.figure.hair", style="%(style)s"),
  "no_hair": _("web.creator.figure.no_hair"),
  "beard": _("web.creator.figure.beard", style="%(style)s"),
  "no_beard": _("web.creator.figure.no_beard"),
  "note": _("web.creator.look.note", faction="%(faction)s"),
  "factions": factions,
  "glyphs": glyphs,
  "classes": classes,
  "checking": _("web.creator.name.checking", name="%(name)s"),
  "ready": _("web.creator.ready", name="%(name)s", slot=slot),
  "needs_name": _("web.creator.needs.name"),
  "needs_free": _("web.creator.needs.free"),
  "of_skin": _("web.creator.of", n="%(n)s", count=rules.skin_tones|length),
  "of_hair": _("web.creator.of", n="%(n)s", count=rules.hair_colours|length),
} %}
<form method="post"
      action="{{ url('/' ~ game.id ~ '/user/createHero') }}"
      aria-labelledby="creator-title"
      data-creator
      data-name-check="{{ url('/' ~ game.id ~ '/heroes/name') }}"
      data-faction="{{ look.faction }}"
      data-class="{{ look.hero_class }}"
      data-skin="{{ look.skin_tone }}"
      data-hair-colour="{{ look.hair_colour }}"
      {% if refused %} data-naming-open{% endif %}
      class="creator enter-panel">
  <script type="application/json" data-creator-texts>{{ texts|tojson }}</script>
  <input type="hidden" name="csrf" value="{{ csrf }}">
  {% if from_game %}<input type="hidden" name="from" value="game">{% endif %}
  <div class="creator-box">
    <CreatorStage :look="look" :who="who[current]" :hair="hair" :beard="beard" :figure="figure" />
    <div class="creator-panel">
      <svg aria-hidden="true"
           focusable="false"
           viewBox="0 0 300 600"
           preserveAspectRatio="none"
           class="panel-grain">
        <path d="M0 40c60-6 120 6 180 0s90-6 120 2M0 190c70 5 140-5 200 0s70 4 100-2M0 360c50-4 110 4 160 0s100-5 140 1M0 530c80 4 150-4 220 0s60 3 80-1" />
      </svg>
      <fieldset class="creator-row">
        <legend class="panel-label">{{ _("web.creator.faction") }}</legend>
        <div class="faction-tiles">
          {% for faction_id, choice in rules.factions.items() %}
            <label data-faction="{{ faction_id }}" class="creator-tile faction-tile">
              <input type="radio"
                     name="faction"
                     value="{{ faction_id }}"
                     {% if faction_id == look.faction %} checked{% endif %}>
              <span class="creator-face">
                <span aria-hidden="true"
                      class="creator-glyph"><Icon :name="choice.glyph" :size="42" stroke="currentColor" /></span>
                <span class="creator-tile-name">{{ _("games." ~ game.id ~ ".faction." ~ faction_id) }}</span>
              </span>
            </label>
          {% endfor %}
        </div>
      </fieldset>
      <fieldset class="creator-row">
        <legend class="panel-label">{{ _("web.creator.class") }}</legend>
        <div class="class-tiles">
          {% for class_id, choice in rules.classes.items() %}
            <label class="creator-tile class-tile">
              <input type="radio"
                     name="class"
                     value="{{ class_id }}"
                     {% if class_id == look.hero_class %} checked{% endif %}>
              <span class="creator-face">
                <span aria-hidden="true"
                      class="creator-glyph"><Icon :name="choice.glyph" :size="42" stroke="currentColor" /></span>
                <span class="creator-tile-name">{{ _("games." ~ game.id ~ ".class." ~ class_id) }}</span>
                <span class="creator-role">{{ _("games." ~ game.id ~ ".class." ~ class_id ~ ".role") }}</span>
              </span>
            </label>
          {% endfor %}
        </div>
      </fieldset>
      <CreatorLook :rules="rules" :look="look" />
      <div class="creator-actions js-only">
        <button type="button" data-surprise class="creator-button creator-surprise">
          <Icon name="dice" :size="18" stroke="#FEDE01" />
          {{ _("web.creator.surprise") }}
        </button>
        <button type="button"
                aria-haspopup="dialog"
                data-done
                class="creator-button creator-done">
          <Icon name="play" :size="16" stroke="#FEDE01" />
          {{ _("web.creator.done") }}
        </button>
      </div>
    </div>
  </div>
  <NamingDialog :rules="rules" :look="look" :roster="roster" :name="name" :refused="refused" :kits="kits" :slot="slot" :who="who[current]" />
</form>

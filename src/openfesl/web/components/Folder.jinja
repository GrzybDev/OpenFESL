{#def caption: str, label: str, files #}
{# A folder's files after a guide's step, each with what the step did to it: added or replaced. #}
<div>
  <p class="folder-caption">{{ caption }}</p>
  <ul aria-label="{{ label }}" class="folder">
    {% for name, mark in files %}
      <li {% if mark %} class="folder-changed"{% endif %}>{{ name }}{% if mark %}<span class="folder-mark">{{ _("web.guide." ~ mark) }}</span>{% endif %}</li>
    {% endfor %}
  </ul>
</div>

{#def cards: list #}
{# The account's wallets in the brown info box under the heroes: its shared balances, each hero's
   own Hero Points and how Funds are earned. #}
<section aria-labelledby="wallets-title" class="info-box info-box-brown">
  <h2 id="wallets-title" class="info-box-title">{{ _("web.site.wallets") }}</h2>
  <span aria-hidden="true" class="info-box-disc"><Icon name="coin" :size="22" stroke="#0A0A0A" /></span>
  <dl class="wallet-rows">
    {% set spent = bar.heroes.slot_price if toast and toast.key == "web.slots.done" else 0 %}
    {% for wallet, balance in bar.wallets %}
      <div>
        <dt>
          <strong>{{ _("games." ~ game.id ~ ".currency." ~ wallet.currency) }}</strong> · {{ _("web.heroes.wallet.shared") }}
        </dt>
        <dd>
          <Count :value="balance" :was="balance + spent if spent and wallet.currency == game.heroes.currency else none" />
        </dd>
      </div>
    {% endfor %}
    <div class="wallet-heroes">
      <dt>
        <strong>{{ _("games." ~ game.id ~ ".currency." ~ game.heroes.points) }}</strong> · {{ _("web.heroes.wallet.own") }}
      </dt>
      <dd>
        {% if cards %}
          {% set lines = [] %}
          {% for card in cards %}
            {% set kept = lines.append(card.hero.persona.name ~ " " ~ number(card.points[0])) %}
          {% endfor %}
          {{ listed(lines) }}
        {% else %}
          {{ _("web.heroes.wallet.none") }}
        {% endif %}
      </dd>
    </div>
  </dl>
  <p class="info-box-note">{{ _("web.heroes.wallet.note") }}</p>
  <FundsLink class="info-box-link"><Icon name="go" :size="12" stroke="currentColor" /></FundsLink>
</section>

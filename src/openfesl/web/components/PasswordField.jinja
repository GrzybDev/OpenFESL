{#def id: str, label: str, note: str = "", new: bool = False, focus: bool = False, tag: str = "", optional: bool = False, error: str = "", name: str = "password" #}
{# A game password field: its label on the accent with a word such as Optional at its end, the
   field with a black button that shows the password where scripts run, in place of a second field
   to repeat it, and under it the error the form must change or else the note that the content
   gives, whose element carries the note's id. #}
<FieldLabel :id="id" :label="label" :tag="tag" />
<div class="password-field{% if error %} field-invalid{% endif %}">
  <input id="{{ id }}"
         name="{{ name }}"
         type="password"
         maxlength="31"
         {% if not optional %} required{% endif %}
         {% if new %} minlength="8" autocomplete="new-password"{% else %} autocomplete="current-password"{% endif %}
         {% if error %} aria-describedby="{{ id }}-error" aria-invalid="true"{% elif note %} aria-describedby="{{ note }}"{% endif %}
         {% if focus %} autofocus{% endif %}
         class="field-input">
  <button type="button"
          aria-pressed="false"
          aria-label="{{ _('web.account.password.show') }}"
          data-show-password
          class="password-show js-only">
    <Icon name="show" :size="20" stroke="currentColor" class="password-shown" />
    <Icon name="hide" :size="20" stroke="currentColor" class="password-hidden" />
  </button>
</div>
{% if error %}
  <FieldError :id="id ~ '-error'">{{ error }}</FieldError>
{% else %}
  {{ content }}
{% endif %}

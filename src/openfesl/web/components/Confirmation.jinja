{#def question: str, action: str, label: str, busy: str, back: str, glyph: str = "go" #}
{# The black-headed panel that asks before a decision, as the game's dialogs: the question, the
   content that says what it does (with the text that describes it as confirm-text), and the
   buttons that go back or send the decision. Where scripts run, a link with data-dialog opens
   it over its page (M10); only there does it close with its own button. #}
<section aria-labelledby="confirm-question"
         aria-describedby="confirm-text"
         data-confirm
         class="confirm">
  <div class="confirm-head">
    <h2 id="confirm-question">{{ question }}</h2>
    <button type="button"
            data-close
            class="confirm-close"
            aria-label="{{ _('web.admin.close') }}">
      <span><Icon name="x" :size="14" stroke="currentColor" /></span>
    </button>
  </div>
  <div class="confirm-body">{{ content }}</div>
  <div class="confirm-buttons">
    <FormButton icon="x" :href="back">{{ _("web.admin.cancel") }}</FormButton>
    <form method="post" action="{{ action }}">
      <CsrfField />
      <input type="hidden" name="confirmed" value="1">
      <input type="hidden" name="back" value="{{ back }}">
      <SmallAction :label="label" :busy="busy" :glyph="glyph" />
    </form>
  </div>
</section>

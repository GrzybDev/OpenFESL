{#def title: str, text: str, subtitle: str = "", rows: list = [], narrow: bool = False #}
{# A short page that says one thing: its title block, the text on a light row, the further rows that
   explain it and the actions the content gives. #}
<div class="enter-title notice-title{% if narrow %} notice-narrow{% endif %}">
  <TitleBlock :title="title">{{ subtitle }}</TitleBlock>
</div>
<div class="enter-panel">
  <div class="notice-rows">
    <Note :text="text" />
    {% for row in rows %}<p class="notice-row">{{ row }}</p>{% endfor %}
  </div>
  <div class="actions">{{ content }}</div>
</div>

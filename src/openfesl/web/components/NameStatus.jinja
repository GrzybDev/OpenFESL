{#def name: str, check: str, id: str = "name-status" #}
{# What a wanted hero name meets, as the naming dialog says it while the name is typed. #}
<p id="{{ id }}"
   role="status"
   data-check="{{ check }}"
   class="name-status">
  {% if check %}
    <Icon :name="'tick' if check == 'free' else 'warn'" :size="18" stroke="currentColor" />
    {{ _("web.rename.same" if check == "same" else "web.creator.name." ~ check, name=name) }}
  {% endif %}
</p>

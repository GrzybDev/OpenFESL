{#def name: str, game = None, official: bool = False #}
{# A dedicated server's name as the heading of a warning or a decision, with its game's chip and
   its official mark. #}
<p class="server-title">
  <span>{{ name }}</span>
  {% if game %}<GameChip :of="game" />{% endif %}
  {% if official %}<OfficialChip />{% endif %}
</p>

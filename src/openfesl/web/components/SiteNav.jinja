{# The menus of a game's own site: a tab per menu that lists one of the game's pages, open without
   scripts as a disclosure, and a signed-in account's heroes; the tab of the current page's menu
   wears the menus' colour. The rewards to claim and the Daily Claw's free grabs that wait are
   counted in green on their entries and the tab of their menu, as the 2012 site counted rewards;
   the Claw is listed while it runs, by its own name. #}
{% set glyphs = {
  "play": "book",
  "leaderboard": "bars",
  "leaderboards": "bars",
  "host": "server",
  "servers": "server",
  "activity": "bars",
  "store": "bag",
  "hot-deals": "deal",
  "treasure-chests": "chest",
  "funds": "coin",
  "rewards": "gift",
  "redeem": "ticket",
  "claw": "claw",
  "friends": "people",
  "search": "find"
} %}
<nav aria-label="{{ game.name }}" class="site-nav">
  <ul class="site-tabs">
    {% for menu in game.site.menus %}
      {% set entries = menu.pages|select("in", game.pages)|reject("equalto", "" if claw else "claw")|list %}
      {% set counts = {"rewards": bar.ready if bar else 0, "claw": claw.waiting if claw else 0} %}
      {% if entries %}
        {% set ns = namespace(current=menu.section and path.startswith("/" ~ game.id ~ menu.section ~ "/")) %}
        {% for kind in entries %}
          {% set base = "/" ~ game.id ~ game.site.path(kind) %}
          {% if path == base or path.startswith(base ~ "/") %}
            {% set ns.current = True %}
          {% endif %}
        {% endfor %}
        {% set tally = namespace(ready=0) %}
        {% for kind in entries %}
          {% set tally.ready = tally.ready + counts.get(kind, 0) %}
        {% endfor %}
        {% set ready = tally.ready %}
        {% set counted = "web.site.rewards_count" if "rewards" in entries else "web.site.claw_count" %}
        <li>
          <details data-site-menu class="site-menu">
            <summary class="site-tab{% if ns.current %} site-tab-current{% endif %}">
              {{ _("games." ~ game.id ~ ".menu." ~ menu.name) }}
              {%- if ready %}<SiteCount :count="ready" :key="counted" />
              {% endif -%}
              <Icon name="down" :size="12" stroke="#FEDE01" class="site-turn" />
            </summary>
            <ul class="site-entries">
              {% for kind in entries %}
                {% set base = "/" ~ game.id ~ game.site.path(kind) %}
                <li>
                  <a href="{{ url(base) }}"
                     {% if path == base %} aria-current="page"{% endif %}
                     class="site-entry"><Icon :name="glyphs[kind]" :size="16" stroke="#F2C12E" />{{ claw.name if kind == "claw" else _("web.site.page." ~ kind) }}
                    {%- if counts.get(kind) %}<SiteCount :count="counts[kind]" :key="'web.site.rewards_count' if kind == 'rewards' else 'web.site.claw_count'" />
                    {% endif -%}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </details>
        </li>
      {% endif %}
    {% endfor %}
    {% if player and game.heroes %}
      {% set mine = "/" ~ game.id ~ "/heroes" %}
      {# Heroes' public profiles lie under the address too, and belong to no menu. #}
      {% set profile = path[mine|length + 1:].isdigit() %}
      <li>
        <a href="{{ url(mine) }}"
           {% if path == mine %} aria-current="page"{% endif %}
           class="site-tab{% if (path.startswith(mine) and not profile) or path.endswith('/createHero') %} site-tab-current{% endif %}">{{ _("web.site.heroes") }}</a>
      </li>
    {% endif %}
  </ul>
</nav>

{#def title: str, tag: str = "h1", id: str = "" #}
{# The title on the accent bar, as the game's title blocks are, and under it the subtitle that the
   content gives. #}
<{{ tag }}{% if id %} id="{{ id }}"{% endif %} class="title-block">{{ title }}</{{ tag }}>
{% if content|trim %}<p class="title-sub">{{ content }}</p>{% endif %}

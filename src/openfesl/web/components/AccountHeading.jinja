{#def id: str, title: str, name: str #}
{# The title of an admin page about an account or what it holds, over its name in the account's own
   capitals. #}
<div class="enter-title page-title page-title-wider">
  <h1 id="{{ id }}" class="account-heading">
    <span class="title-block">{{ title }}</span>
    <span class="title-sub account-heading-name">{{ name }}</span>
  </h1>
</div>

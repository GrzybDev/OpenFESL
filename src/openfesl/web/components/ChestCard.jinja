{#def held, keys: int, price: str, closed: bool = False #}
{# A hero's treasure chests on its card: its faction's tab, its class and level, a chest for each
   one it has to open, when it last found one, and the form that opens one with a key. Without a
   key, or while opening is switched off, the form stays in view, unavailable, saying why. #}
{% set hero = held.hero %}
{% set rules = game.heroes %}
{% set id = hero.persona.id %}
<li id="chests-{{ id }}"
    {% if hero.faction %} data-faction="{{ hero.faction }}"{% endif %}
    class="pale-hanger">
  <Splash />
  <article aria-labelledby="chest-hero-{{ id }}" class="pale-card">
    <FactionTab :hero="hero" :size="18" class="pale-band" />
    <div class="chest-body">
      <div class="chest-hero">
        <span aria-hidden="true" class="chest-class">
          {% if hero.hero_class %}
            <Icon :name="rules.classes[hero.hero_class].glyph" :size="24" stroke="currentColor" />
          {% endif %}
        </span>
        <div>
          <h3 id="chest-hero-{{ id }}" class="chest-name">{{ hero.persona.name }}</h3>
          <p>
            <HeroKind :hero="hero" />
          </p>
        </div>
      </div>
      <div class="chest-strip">
        {% for _chest in range([held.count, 12]|min) %}
          <Icon name="chest" :size="32" stroke="#F2C12E" />
        {% endfor %}
        {% if held.count > 12 %}
          <span aria-hidden="true" class="chest-more">+{{ number(held.count - 12) }}</span>
        {% elif not held.count %}
          <span class="chest-strip-none">{{ _("web.chests.hero.empty") }}</span>
        {% endif %}
      </div>
      <p class="chest-count">
        <strong>
          {% if held.count %}
            {{ _n("web.chests.total", held.count) }}
          {% else %}
            {{ _("web.chests.hero.none") }}
          {% endif %}
        </strong>
        <span>·
          {% if held.found %}
            {{ _("web.chests.hero.found", date=when(held.found, "yMMMd")) }}
          {% else %}
            {{ _("web.chests.hero.never") }}
          {% endif %}
        </span>
      </p>
      {% if held.count %}
        {% set unable = closed or not keys %}
        <form method="post"
              action="{{ url('/' ~ game.id ~ '/treasure-chests/' ~ id ~ '/open') }}"
              data-once
              class="chest-open">
          <input type="hidden" name="csrf" value="{{ csrf }}">
          <SiteButton :id="'chest-open-' ~ id" :aria-disabled="'true' if unable else none" :aria-describedby="('chest-why-' ~ id) if unable else none" glyph="key" :size="18" :stroke="'currentColor' if unable else '#FEDE01'" class="site-button-large">{{ _("web.chests.open") }}<span class="sr-only">{{ hero.persona.name }}</span></SiteButton>
          {% if unable %}
            <p id="chest-why-{{ id }}" class="chest-why">
              {% if closed %}
                {{ _("web.chests.open.why.closed") }}
              {% elif price %}
                {{ _("web.chests.open.why", price=price) }}
              {% else %}
                {{ _("web.chests.open.why.unsold") }}
              {% endif %}
            </p>
          {% endif %}
        </form>
      {% else %}
        <p class="chest-later">{{ _("web.chests.hero.later") }}</p>
      {% endif %}
    </div>
  </article>
</li>

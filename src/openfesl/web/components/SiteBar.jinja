{# The bar of a game's own site for a signed-in account: its default hero, or a way to create the
   first, the toggle of the hero selector, and the balances it has to spend. #}
<div class="site-bar">
  {% if bar and bar.roster %}
    {% set hero = bar.roster.default %}
    {% if hero %}
      <a href="{{ url('/' ~ game.id ~ '/heroes') }}"
         class="hero-pill{% if toast and toast.key == 'web.heroes.toast.default' %} hero-pill-changed{% endif %}">
        <span aria-hidden="true"
              {% if hero.faction %} data-faction="{{ hero.faction }}"{% endif %}
              class="hero-pill-disc">
          {% if hero.hero_class %}
            <Icon :name="game.heroes.classes[hero.hero_class].glyph" :size="20" stroke="currentColor" />
          {% endif %}
        </span>
        <span class="hero-pill-text"><span class="hero-pill-label">{{ _("web.bar.default") }}</span><span class="hero-pill-name">{{ hero.persona.name }}</span></span>
        <span class="hero-pill-level"><span class="sr-only">{{ _("web.bar.level") }}</span>{{ hero.level }}</span>
      </a>
    {% endif %}
    {% if bar.roster.heroes %}
      <a href="{{ url('/' ~ game.id ~ '/heroes') }}"
         data-selector-toggle
         class="heroes-toggle">{{ _("web.bar.heroes") }}<span class="heroes-count">{{ bar.roster.heroes|length }}</span><Icon name="down" :size="14" stroke="#FEDE01" class="heroes-turn" /></a>
    {% else %}
      <a href="{{ url('/' ~ game.id ~ '/user/createHero') }}"
         class="hero-pill hero-pill-none">
        <span aria-hidden="true" class="hero-pill-disc"><Icon name="plus" :size="18" stroke="currentColor" /></span>
        <span class="hero-pill-text"><span class="hero-pill-label">{{ _("web.bar.no_hero") }}</span><span class="hero-pill-name">{{ _("web.bar.create") }}</span></span>
      </a>
    {% endif %}
  {% endif %}
  {% if bar and bar.wallets %}
    <ul aria-label="{{ _('web.site.wallets') }}" class="site-wallets">
      {% for wallet, balance in bar.wallets %}
        <li data-wallet="{{ wallet.currency }}" class="site-wallet">
          <span aria-hidden="true"
                class="wallet-coin"><Icon :name="wallet.glyph" :size="18" stroke="currentColor" /></span>
          <span class="wallet-amount"><span class="wallet-number">{{ number(balance) }}</span>
            <span class="wallet-name">{{ _("games." ~ game.id ~ ".currency." ~ wallet.currency) }}</span></span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

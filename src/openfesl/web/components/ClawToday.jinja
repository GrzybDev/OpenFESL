{#def of, claw #}
{# The Claw's grabs of the rewards' day so far: free, paid, and what the paid ones cost. #}
{% set free, paid, spent = claw.counts %}
<dl class="claw-today">
  <div>
    <Term :label="_('web.admin.boxes.claw.today.free')">{{ number(free) }}</Term>
  </div>
  <div>
    <Term :label="_('web.admin.boxes.claw.today.paid')">{{ number(paid) }}</Term>
  </div>
  <div>
    <Term :label="_('web.admin.boxes.claw.today.spent', currency=_('games.' ~ of.id ~ '.currency.' ~ claw.rules.paid.currency))">{{ number(spent) }}</Term>
  </div>
</dl>

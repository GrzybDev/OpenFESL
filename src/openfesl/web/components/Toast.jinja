{# What came of the admin's last change, at the bottom right (M11): a success leaves on its own,
   an error stays until dismissed. #}
{% set shown = viewer.toast %}
<div class="toasts">
  <div role="{{ 'alert' if shown.error else 'status' }}"
       {% if not shown.error %} data-leaves{% endif %}
       class="toast{% if shown.error %} toast-error{% endif %}">
    <span aria-hidden="true" class="toast-icon">
      {% if shown.error %}
        <Icon name="warn" :size="22" fill="#0A0A0A" />
      {% else %}
        <Icon name="tick" :size="22" stroke="#0A0A0A" />
      {% endif %}
    </span>
    <p class="toast-body">
      <span class="toast-label">{{ _("web.admin.toast.error") if shown.error else _("web.admin.toast.saved") }}</span>
      <span class="toast-text">{{ _(shown.key, **shown.values) }}</span>
    </p>
    <button type="button"
            data-dismiss
            class="toast-dismiss js-only"
            aria-label="{{ _('web.admin.toast.dismiss') }}">
      <span><Icon name="x" :size="14" stroke="currentColor" /></span>
    </button>
  </div>
</div>

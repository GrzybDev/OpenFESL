{#def reveal: dict #}
{# What a box just bought gave the hero: a burst rises and the item comes up into it. Scripts open
   it over the page once; without them, and with reduced motion, it shows its final state at the
   top of the page. #}
<dialog open
        id="box-reveal"
        aria-labelledby="reveal-title"
        data-reveal
        class="site-dialog box-reveal">
  <div class="site-dialog-box">
    <button type="button"
            data-close
            class="site-dialog-close js-only"
            aria-label="{{ _('web.dialog.close') }}">
      <Icon name="x" :size="18" stroke="currentColor" />
    </button>
    <h2 id="reveal-title" class="site-dialog-title">{{ _("web.store.reveal.title") }}</h2>
    <RevealStage glyph="bag"
                 :size="36"
                 :recipient="_('web.store.reveal.for', hero=reveal['hero'])"
                 :item="reveal['item']"
                 :line="reveal['line']" />
    <p class="store-hint">{{ _("web.store.reveal.after", game=game.name) }}</p>
    <div class="site-dialog-actions js-only">
      <button type="button" data-close class="site-button site-button-ghost">{{ _("web.dialog.close") }}</button>
    </div>
  </div>
</dialog>

{#def rules, roster, name: str, refused: str, kits: dict, slot: int #}
{# The creator's naming part: the name, the slot, the default hero and the starting kit of each
   faction and class; Create hero sends the form. #}
<section aria-labelledby="naming-title" class="site-box site-box-pale naming">
  <h2 id="naming-title" class="site-box-title">{{ _("web.creator.naming") }}</h2>
  <label for="hero-name" class="naming-label">{{ _("web.creator.name") }}</label>
  <input id="hero-name"
         name="name"
         type="text"
         required
         minlength="{{ rules.name_length[0] }}"
         maxlength="{{ rules.name_length[1] }}"
         pattern="{{ rules.name }}"
         autocomplete="off"
         spellcheck="false"
         aria-describedby="name-hint name-status"
         {% if refused in ("format", "taken") %} aria-invalid="true"{% endif %}
         value="{{ name }}"
         class="naming-input">
  <p id="name-hint" class="naming-hint">{{ _("web.creator.name.hint") }}</p>
  {% set check = {"format": "format", "taken": "refused"}.get(refused, "") %}
  <NameStatus :name="name" :check="check" />
  <dl class="site-facts">
    <dt>{{ _("web.creator.slot") }}</dt>
    <dd>
      {{ _("web.creator.slot.of", slot=slot, slots=roster.slots) }}
    </dd>
    <dt>{{ _("web.creator.default") }}</dt>
    <dd>
      {% if roster.default %}
        {{ _("web.creator.default.stays", hero=roster.default.persona.name) }}
      {% else %}
        {{ _("web.creator.default.becomes") }}
      {% endif %}
    </dd>
    <dt>{{ _("web.creator.kit") }}</dt>
    <dd>
      <ul class="naming-kits">
        {% for key, kit in kits.items() %}
          <li>
            {% set faction_id, class_id = key.split(".") %}
            <span class="naming-kit-who">{{ _("web.creator.who", hero_class=_("games." ~ game.id ~ ".class." ~ class_id), faction=_("games." ~ game.id ~ ".faction." ~ faction_id)) }}:</span>
            {{ kit }}
          </li>
        {% endfor %}
      </ul>
    </dd>
  </dl>
  <div class="site-actions">
    <button type="submit" class="site-button site-button-go site-button-large">
      <Icon name="tick" :size="18" stroke="currentColor" />
      {{ _("web.creator.create") }}
    </button>
  </div>
</section>

{#def roster, funds: int, next: str, dialog: bool = False #}
{# The form that buys a further hero slot for Funds: the price and any sale of it, the Funds before
   and after, the slots before and after, and why it cannot be sent when the account has too few.
   Pages open it as a dialog; without scripts it is a page of its own. #}
{% set rules = bar.heroes %}
{% set price = rules.slot_price %}
{% set short = funds < price %}
{% set currency = _("games." ~ game.id ~ ".currency." ~ rules.currency) %}
<form method="post"
      action="{{ url('/' ~ game.id ~ '/user/buyCharacterSlots') }}"
      data-once
      class="site-dialog-box">
  <input type="hidden" name="csrf" value="{{ csrf }}">
  <input type="hidden" name="next" value="{{ next }}">
  <input type="hidden" name="once" value="{{ once_token() }}">
  <input type="hidden" name="price" value="{{ price }}">
  <DialogHead :id="'buy-slot-title' if dialog else 'buy-slot-title-page'" :dialog="dialog">{{ _("web.slots.buy") }}</DialogHead>
  <dl class="site-facts">
    <SaleFacts :sale="rules.slot_sale" :price="number(price) ~ ' ' ~ currency" />
    <Term :label="_('web.rename.funds_now', currency=currency)">
    {{ number(funds) }}
    {% if short %}<span class="site-short">· {{ _("web.rename.short", amount=number(price - funds)) }}</span>{% endif %}
    </Term>
    {% if not short %}
      <Term :label="_('web.rename.funds_after', currency=currency)">{{ number(funds - price) }}</Term>
    {% endif %}
    <Term :label="_('web.slots.title')">{{ roster.slots }} → {{ roster.slots + 1 }}</Term>
  </dl>
  <p class="slot-kept">{{ _("web.slots.kept") }}</p>
  <div class="site-dialog-actions">
    <SiteButton :aria-describedby="'buy-slot-why' if dialog else 'buy-slot-why-page'" :aria-disabled="'true' if short else none" glyph="coin" :size="18" stroke="currentColor" class="site-button-go site-button-large">{{ _("web.slots.submit", price=number(price), currency=currency) }}</SiteButton>
    <DialogCancel :back="next or url('/' ~ game.id ~ '/heroes')" :dialog="dialog" />
    {% if short %}<FundsLink class="site-link" />{% endif %}
  </div>
  <p id="buy-slot-why{{ '' if dialog else '-page' }}"
     data-why
     class="site-dialog-why">
    {% if short %}
      {{ _("web.slots.why.funds", funds=number(funds), price=number(price), currency=currency) }}
    {% endif %}
  </p>
</form>

{#def game, item, shown: bool #}
{# An item's icon on a row of the admin panel, withheld items' too, or a dashed placeholder where the
   catalogue keeps none. #}
<ItemImage :src="url('/admin/icons/' ~ game.id ~ '/' ~ item.id) if shown and item and item.icon else ''" :size="44" glyph="doc" :glyph_size="18" class="admin-item-icon" drawn="admin-item-icon-none" />

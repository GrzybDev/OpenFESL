{#def sold, texts, icons: list #}
{# What a store page sells, in the green box beside the buy panel: a hot deal's sticker and the
   time it has left, the items a bundle holds or a box may give with their chances, which heroes
   may have it and what else holds for it. The icons are the items' imported icons in the rows'
   order, none for an item whose tile the page draws itself. #}
{% set box = sold.kind == "box" %}
<section aria-labelledby="contents-title" class="store-contents">
  <Splash />
  <div class="store-box site-box-green">
    <span aria-hidden="true"
          class="store-disc"><Icon :name="'bag' if sold.kind == 'item' else sold.kind" :size="22" stroke="#0A0A0A" /></span>
    <h2 id="contents-title" class="store-tab">{{ _("web.store.contents." ~ sold.kind) }}</h2>
    {% set price = sold.prices[0] %}
    {% if sold.kind == "deal" and price.original_price and price.original_price > price.price %}
      {% set off = texts.off(price) %}
      <DealSticker :off="off" class="store-sticker" />
    {% endif %}
    {% if sold.kind == "deal" and sold.ends and not sold.ended %}
      <div class="store-timer">
        <Icon name="clock" :size="24" stroke="#FEDE01" />
        <p>
          {{ _("web.store.deal.ends_in") }}
          <strong role="timer"
                  data-left="{{ seconds_left(sold.ends) }}"
                  data-format="{{ _('web.store.countdown') }}">{{ texts.countdown(sold.ends) }}</strong>
          <span class="store-timer-end">{{ texts.moment(sold.ends) }}</span>
        </p>
      </div>
    {% endif %}
    <div aria-hidden="true" class="store-art">
      {% if box %}
        <span class="store-icon"><Icon name="box" :size="28" stroke="currentColor" /></span>
      {% else %}
        {# A tile for each of a bundle's first three items, as the 2012 page showed their icons. #}
        {% set small = icons|length > 1 %}
        {% for src in icons[:3] %}
          <ItemImage :src="src" :size="76 if small else 110" :glyph="'bag' if sold.kind == 'item' else 'deal'" :glyph_size="28" :class="'store-icon store-icon-small' if small else 'store-icon'" eager />
        {% endfor %}
      {% endif %}
    </div>
    <ul role="list" class="store-rows">
      {% if sold.kind == "item" %}
        <li>
          <ItemIcon :src="icons[0]" />
          <span class="store-row-text"><strong>{{ sold.name }}</strong>
            <span>{{ texts.chosen(sold) }}</span></span>
        </li>
      {% endif %}
      {% for content in sold.contents %}
        <li>
          <ItemIcon :src="icons[loop.index0]" />
          <span class="store-row-text"><strong>{{ content.name }}</strong>
            <span>{{ texts.ownership(content.ownership) }}</span></span>
          {% if content.chance is not none %}
            <span class="store-chance"><span class="sr-only">{{ _("web.store.chance") }}</span>{{ texts.percent(content.chance) }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
    <dl class="store-facts">
      <Term :label="_('web.store.requires')">{{ texts.requires(sold.requirement) }}</Term>
      {% if sold.kind != "item" or sold.description %}
        <Term :label="_('web.store.about')">
        {% for paragraph in sold.description %}<p>{{ paragraph }}</p>{% endfor %}
        {% if sold.kind != "item" %}<p>{{ _("web.store.about." ~ sold.kind) }}</p>{% endif %}
        </Term>
      {% endif %}
    </dl>
    {% if box %}
      <p class="store-rule">
        {% if sold.worth is not none %}
          {{ _("web.store.box.worth", price=texts.priced(sold.worth, price.currency)) }}
        {% else %}
          {{ _("web.store.box.plain") }}
        {% endif %}
        {{ _("web.store.box.chances") }}
      </p>
    {% endif %}
  </div>
</section>

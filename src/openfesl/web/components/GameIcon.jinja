{#def game, icon, refused, manages: bool, reachable: bool, base: str, replacing: str, largest: int #}
{# A game's icon for Discord presence on the admin panel's settings: the image with its facts and a
   preview of presence, the buttons that replace or remove it, and the upload, which Replace opens
   in place. The upload is open while the game has no icon, its last upload was refused or it is
   the game being replaced; a warning names the base address when Discord cannot reach it. #}
{% set refusal = refused if refused and refused.game == game.id else none %}
{% set key = "presence-" ~ game.id %}
{% set open = not icon or refusal or replacing == game.id %}
<section aria-labelledby="{{ key }}-title"
         id="{{ key }}"
         data-key="{{ key }}"
         {% if open %} data-open{% endif %}
         class="game-icon">
  <Bar tag="h3" :id="key ~ '-title'" :extra="_('web.admin.icon.set') if icon else _('web.admin.icon.none')" wrap>{{ _("web.admin.icon") }}</Bar>
  {% if not reachable %}
    <FieldError class="game-icon-warning">{{ _("web.admin.icon.unreachable", address=base) }}</FieldError>
  {% endif %}
  <div class="game-icon-row">
    {% if icon %}
      <img src="{{ icon.src }}"
           width="96"
           height="96"
           alt="{{ _('web.admin.icon.of', game=game.name) }}"
           class="game-icon-image">
      <dl class="game-icon-facts">
        <div>
          <Term :label="_('web.admin.icon.image')">{{ _("web.admin.icon.image.value", width=number(icon.width), height=number(icon.height), size=number(icon.kilobytes)) }}</Term>
        </div>
        <div>
          <Term :label="_('web.admin.icon.address')"><code class="entitlement-code">{{ icon.address }}</code></Term>
        </div>
        {% if icon.at %}
          <div>
            <Term :label="_('web.admin.icon.stored')">{{ _("web.server.time", time=moment(icon.at)) }} · {{ icon.by or _("web.admin.command_line") }}</Term>
          </div>
        {% endif %}
      </dl>
      <figure class="game-icon-card">
        <figcaption class="game-icon-card-kicker">{{ _("web.admin.icon.preview") }}</figcaption>
        <div class="game-icon-card-row">
          <span class="game-icon-card-art">
            <img src="{{ icon.src }}" width="72" height="72" alt="">
            <img src="{{ static('apple-touch-icon.png') }}"
                 width="20"
                 height="20"
                 alt=""
                 class="game-icon-card-badge">
          </span>
          <span class="game-icon-card-text">
            <span class="game-icon-card-name">{{ game.name }}</span>
            <span class="game-icon-card-line">{{ _("presence.menus") }}</span>
          </span>
        </div>
      </figure>
      {% if manages %}
        <div class="game-icon-buttons">
          <FormButton icon="retry" :href="url('/admin/settings') ~ ('' if open else '?icon=' ~ game.id) ~ '#' ~ key" role="button" :aria-expanded="'true' if open else 'false'" :aria-controls="key ~ '-upload'" data-details class="game-icon-replace">
          {{ _("web.admin.icon.replace") }}
          </FormButton>
          <form method="post"
                action="{{ url('/admin/settings/games/' ~ game.id ~ '/icon/remove') }}">
            <CsrfField />
            <FormButton icon="x">{{ _("web.admin.icon.remove") }}</FormButton>
          </form>
        </div>
      {% endif %}
    {% else %}
      <img src="{{ static('favicon.svg') }}"
           width="40"
           height="40"
           alt=""
           class="game-icon-empty">
      <p class="game-icon-text">{{ _("web.admin.icon.empty") }}</p>
    {% endif %}
  </div>
  {% if manages %}
    <div id="{{ key }}-upload" class="game-icon-drawer">
      <form method="post"
            enctype="multipart/form-data"
            action="{{ url('/admin/settings/games/' ~ game.id ~ '/icon') }}"
            class="drawer-cell">
        <CsrfField />
        <label class="game-icon-file">
          <span>{{ _("web.admin.file") }}</span>
          <span data-file-name
                data-none="{{ _('web.admin.icon.file.none') }}"
                class="game-icon-file-name js-only">{{ refusal.name if refusal and refusal.name else _("web.admin.icon.file.none") }}</span>
          <input type="file"
                 name="icon"
                 accept=".png,.ico,image/png,image/x-icon,image/vnd.microsoft.icon"
                 required
                 aria-describedby="{{ key }}-note"
                 {% if refusal %} aria-invalid="true"{% endif %}
                 class="game-icon-file-input">
          <span aria-hidden="true" class="form-button js-only">{{ _("web.admin.icon.choose") }}</span>
        </label>
        {% if refusal %}
          <FieldError :id="key ~ '-note'" role="alert">{{ _("web.admin.icon.refused." ~ refusal.problem, most=number(largest)) }}</FieldError>
        {% else %}
          <p id="{{ key }}-note" class="field-note">{{ _("web.admin.icon.file.text") }}</p>
        {% endif %}
        <div class="settings-save">
          <SmallAction :label="_('web.admin.icon.store')" :busy="_('web.admin.icon.storing')" />
        </div>
      </form>
    </div>
  {% endif %}
  <p class="body-text side-note">
    {{ _("web.admin.icon.note") }}
    {% if icon and not reachable %}{{ _("web.admin.icon.unreachable.note") }}{% endif %}
    {% if not manages %}{{ _("web.admin.icon.managed") }}{% endif %}
  </p>
</section>

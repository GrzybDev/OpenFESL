{#def hero, funds: int, name: str = "", check: str = "", dialog: bool = False #}
{# The form that gives a hero a new name for Funds: the name checked as it is typed, the price
   and any sale of it, the Funds left after it, and why it cannot be sent when the account has
   too few. Heroes pages open it as a dialog; without scripts it is a page of its own. #}
{% set rules = bar.heroes %}
{% set price = rules.rename_price %}
{% set short = funds < price %}
{% set id = hero.persona.id %}
{% set currency = _("games." ~ game.id ~ ".currency." ~ rules.currency) %}
<form method="post"
      action="{{ url('/' ~ game.id ~ '/heroes/' ~ id ~ '/rename') }}"
      class="site-dialog-box">
  <input type="hidden" name="csrf" value="{{ csrf }}">
  <input type="hidden" name="price" value="{{ price }}">
  <DialogHead :id="'rename-title-' ~ id" :dialog="dialog">{{ _("web.rename.title", hero=hero.persona.name) }}</DialogHead>
  <NameField :id="'rename-name-' ~ id" :label="_('web.rename.name')" :hint="_('web.rename.hint')" :name="name" :check="check" />
  <dl class="site-facts">
    <SaleFacts :sale="rules.rename_sale" :price="number(price) ~ ' ' ~ currency" />
    {% if short %}
      <Term :label="_('web.rename.funds_now', currency=currency)">{{ number(funds) }} <span class="site-short">· {{ _("web.rename.short", amount=number(price - funds)) }}</span></Term>
    {% else %}
      <Term :label="_('web.rename.funds_after', currency=currency)">{{ number(funds - price) }}</Term>
    {% endif %}
  </dl>
  <div class="site-dialog-actions">
    <SiteButton :aria-describedby="'rename-why-' ~ id" data-submit :aria-disabled="'true' if short else none" glyph="edit" :size="18" stroke="currentColor" class="site-button-go site-button-large">{{ _("web.rename.submit", price=number(price), currency=currency) }}</SiteButton>
    <DialogCancel :back="url('/' ~ game.id ~ '/heroes')" :dialog="dialog" />
    {% if short %}<FundsLink class="site-link" />{% endif %}
  </div>
  <p id="rename-why-{{ id }}" data-why class="site-dialog-why">
    {% if short %}
      {{ _("web.rename.why.funds", funds=number(funds), price=number(price), currency=currency) }}
    {% endif %}
  </p>
</form>

{#def hero, checked: bool, status: str = "", off: bool = False, holds: bool = False, changed: bool = False #}
{# One of the account's heroes as a tile to choose on the store's pages: its faction's tab, its
   class's disc, its name, class and level, and, on an item's page, what it holds of the item or
   why it cannot have it. An unavailable hero stays choosable to see why. #}
{% set rules = game.heroes %}
<label {% if hero.faction %}data-faction="{{ hero.faction }}"{% endif %}
       class="store-hero{% if off %} store-hero-off{% endif %}">
  <input type="radio"
         name="hero"
         value="{{ hero.persona.id }}"
         {% if status %} aria-describedby="hero-{{ hero.persona.id }}"{% endif %}
         {% if off %} aria-disabled="true"{% endif %}
         {% if checked %} checked{% endif %}
         class="sr-only">
  <span class="store-hero-card">
    <span class="store-hero-tab">
      {% if hero.faction %}
        <Icon :name="rules.factions[hero.faction].glyph" :size="16" stroke="currentColor" />
        {{ _("games." ~ game.id ~ ".faction." ~ hero.faction) }}
      {% endif %}
    </span>
    <span aria-hidden="true" class="store-hero-disc">
      {% if hero.hero_class %}
        <Icon :name="rules.classes[hero.hero_class].glyph" :size="24" stroke="currentColor" />
      {% endif %}
    </span>
    <span class="store-hero-name">{{ hero.persona.name }}</span>
    <span class="store-hero-kind">
      {% if hero.hero_class %}
        {{ _("web.heroes.kind", hero_class=_("games." ~ game.id ~ ".class." ~ hero.hero_class), level=hero.level) }}
      {% else %}
        {{ _("web.heroes.level", level=hero.level) }}
      {% endif %}
    </span>
    {% if status %}
      <span id="hero-{{ hero.persona.id }}"
            class="store-hero-status{% if holds %} store-hero-holds{% endif %}{% if changed %} store-hero-changed{% endif %}">{{ status }}</span>
    {% endif %}
  </span>
</label>

{#def card, funds: int #}
{# A hero's card, a folder hanging from the beam on two strings: its faction's tab, the default
   hero's stamp, its name, class and level, its XP, its facts and what can be done with it. #}
{% set hero = card.hero %}
{% set rules = game.heroes %}
{% set id = hero.persona.id %}
{# A hero becoming the default one: its stamp lands, and the previous default's stamp fades. #}
{% set switched = toast and toast.key == "web.heroes.toast.default" %}
{% set renamed = toast and toast.key == "web.rename.done" and toast.values.new == hero.persona.name %}
<li id="hero-{{ id }}"
    {% if hero.faction %} data-faction="{{ hero.faction }}"{% endif %}
    class="hero-hanger">
  <span aria-hidden="true" class="hero-beam"></span>
  <div class="hero-folder">
    <span aria-hidden="true" class="hero-string hero-string-left"></span>
    <span aria-hidden="true" class="hero-string hero-string-right"></span>
    <article aria-labelledby="hero-name-{{ id }}" class="hero-card">
      {% if hero.faction %}
        <p class="hero-tab">
          <Icon :name="rules.factions[hero.faction].glyph" :size="18" stroke="currentColor" />
          {{ _("games." ~ game.id ~ ".faction." ~ hero.faction) }}
        </p>
      {% endif %}
      <div class="hero-heading">
        <h3 id="hero-name-{{ id }}"
            class="hero-name{% if hero.persona.name|length > 13 %} hero-name-long{% endif %}{% if renamed %} hero-name-renamed{% endif %}">
          {{ hero.persona.name }}
          {% if card.default %}<span class="sr-only">{{ _("web.heroes.default.sr") }}</span>{% endif %}
        </h3>
        {% if card.default %}
          <span aria-hidden="true"
                class="hero-stamp{% if switched %} hero-stamp-landing{% endif %}">{{ _("web.heroes.stamp") }}</span>
        {% elif switched and toast.values.previous == hero.persona.name %}
          <span aria-hidden="true" class="hero-stamp hero-stamp-leaving">{{ _("web.heroes.stamp") }}</span>
        {% endif %}
      </div>
      <div class="hero-face">
        <HeroMugshot :hero="hero" />
        <dl class="hero-rank">
          {% if hero.hero_class %}
            <div>
              <dt class="sr-only">{{ _("web.creator.class") }}</dt>
              <dd class="hero-kind">
                <span aria-hidden="true"
                      class="hero-glyph"><Icon :name="rules.classes[hero.hero_class].glyph" :size="18" stroke="currentColor" /></span>
                {{ _("games." ~ game.id ~ ".class." ~ hero.hero_class) }}
              </dd>
            </div>
          {% endif %}
          <div class="hero-level">
            <dt>{{ _("web.heroes.level.label") }}</dt>
            <dd>
              {{ hero.level }}
            </dd>
          </div>
        </dl>
      </div>
      {% if card.xp_needed %}
        <div class="hero-xp">
          <p>
            <span>{{ _("web.heroes.xp.to", level=hero.level + 1) }}</span>
            <span class="hero-xp-numbers">{{ number(hero.xp) }} / {{ number(card.xp_needed) }}</span>
          </p>
          <ProgressBar :share="hero.xp / card.xp_needed" :label="_('web.heroes.xp.label', xp=number(hero.xp), needed=number(card.xp_needed), level=hero.level + 1)" />
        </div>
      {% endif %}
      <dl class="hero-facts">
        <dt>{{ _("games." ~ game.id ~ ".currency." ~ rules.points) }}</dt>
        <dd>
          <strong>{{ _("web.heroes.points.of", unspent=number(card.points[0]), earned=number(card.points[1])) }}</strong>
          <span class="hero-scope">· {{ _("web.heroes.points.scope") }}</span>
        </dd>
        <dt>{{ _("web.heroes.items") }}</dt>
        <dd>
          <strong>{{ _n("web.heroes.items.count", card.items) }}</strong>
          {% if card.low %}
            <strong class="hero-low">· {{ _n("web.heroes.items.low", card.low) }}</strong>
          {% else %}
            <span class="hero-scope">· {{ _("web.heroes.items.none_low") }}</span>
          {% endif %}
        </dd>
        {% if card.chests is not none %}
          <dt>{{ _("web.heroes.chests") }}</dt>
          <dd>
            {% if card.chests %}
              <strong>{{ _n("web.heroes.chests.count", card.chests) }}</strong>
            {% else %}
              {{ _("web.heroes.chests.none") }}
            {% endif %}
          </dd>
        {% endif %}
        <dt>{{ _("web.heroes.enlisted") }}</dt>
        <dd>
          {{ when(hero.created, "yMMMd") }}
        </dd>
      </dl>
      <div class="hero-actions">
        <a href="{{ url('/' ~ game.id ~ '/heroes/' ~ id ~ '/rename') }}"
           data-opens="rename-{{ id }}"
           class="site-button site-button-ghost hero-rename"><Icon name="edit" :size="17" stroke="currentColor" />{{ _("web.rename.action") }}<span class="sr-only">{{ hero.persona.name }}</span><span class="hero-price">· {{ _("web.rename.price.short", price=number(rules.rename_price), currency=_("games." ~ game.id ~ ".currency." ~ rules.currency)) }}</span></a>
        {# A hero made before the creator has no faction, class or look to start the game with. #}
        {% if not card.default and hero.playable %}
          <form method="post"
                action="{{ url('/' ~ game.id ~ '/heroes/' ~ id ~ '/default') }}">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <button type="submit" class="site-button site-button-yellow">
              <Icon name="star" :size="15" stroke="currentColor" />
              {{ _("web.heroes.make_default") }} <span class="sr-only">{{ hero.persona.name }}</span>
            </button>
          </form>
        {% endif %}
      </div>
    </article>
  </div>
  <dialog id="rename-{{ id }}"
          aria-labelledby="rename-title-{{ id }}"
          data-rename
          data-modal
          data-check-address="{{ url('/' ~ game.id ~ '/heroes/name') }}?{{ {'current': hero.persona.name}|urlencode }}"
          data-checking="{{ _('web.creator.name.checking', name='%(name)s') }}"
          data-needs-free="{{ _('web.rename.needs.free') }}"
          class="site-dialog">
    <RenameForm :hero="hero" :funds="funds" dialog />
  </dialog>
</li>

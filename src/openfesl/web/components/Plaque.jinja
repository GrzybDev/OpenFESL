{#def id: str, level: int = 1 #}
{# A page's title, or a section's at a lower level, on a wooden plaque with two nails, tilted as
   the 2012 site hung them. #}
<div class="plaque enter-title">
  <svg aria-hidden="true"
       focusable="false"
       viewBox="0 0 300 60"
       preserveAspectRatio="none"
       class="plaque-grain">
    <path d="M0 18c60-5 120 5 180 0s90-5 120 2M0 42c70 4 140-4 200 0s70 3 100-2" />
  </svg>
  <h{{ level }} id="{{ id }}" class="plaque-title">{{ content }}</h{{ level }}>
</div>

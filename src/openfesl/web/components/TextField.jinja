{#def name: str, id: str = "", label: str = "", value = "", type: str = "text", tag: str = "", note: str = "", error: str = "", wrong: bool = False #}
{# A form's field: its label on the accent with a word such as Public at its end, the field on the
   light row, and under it the error the form must change or else the note. A field whose error
   stands elsewhere is only marked wrong. Further attributes go on the field. #}
{% if label %}
  <FieldLabel :id="id" :label="label" :tag="tag" />
{% endif %}
<input {% if id %}id="{{ id }}"{% endif %}
       name="{{ name }}"
       type="{{ type }}"
       value="{{ value }}"
       {% if error or note %} aria-describedby="{{ id }}-note"{% endif %}
       {% if error or wrong %} aria-invalid="true"{% endif %}
       {{ attrs.render(class="field-input field-invalid" if error or wrong else "field-input") }}>
{% if error %}
  <FieldError :id="id ~ '-note'">{{ error }}</FieldError>
{% elif note %}
  <p id="{{ id }}-note" class="field-note">{{ note }}</p>
{% endif %}

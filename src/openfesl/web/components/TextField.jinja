{#def id: str, name: str, label: str, value: str = "", type: str = "text", tag: str = "", note: str = "", error: str = "", autocomplete: str = "off", required: bool = True, minlength: int = 0, maxlength: int = 0, pattern: str = "" #}
{# A form's field: its label on the accent with a word such as Public at its end, the field on the
   light row, and under it the error the form must change or else the note. #}
<label for="{{ id }}"
       class="field-label field-label-joined{% if tag %} field-label-tagged{% endif %}">
  {% if tag %}
    <span>{{ label }}</span><span>{{ tag }}</span>
  {% else %}
    {{ label }}
  {% endif %}
</label>
<input id="{{ id }}"
       name="{{ name }}"
       type="{{ type }}"
       value="{{ value }}"
       autocomplete="{{ autocomplete }}"
       spellcheck="false"
       {% if required %} required{% endif %}
       {% if minlength %} minlength="{{ minlength }}"{% endif %}
       {% if maxlength %} maxlength="{{ maxlength }}"{% endif %}
       {% if pattern %} pattern="{{ pattern }}"{% endif %}
       {% if error or note %} aria-describedby="{{ id }}-note"{% endif %}
       {% if error %} aria-invalid="true"{% endif %}
       class="field-input{% if error %} field-invalid{% endif %}">
{% if error %}
  <FieldError :id="id ~ '-note'">{{ error }}</FieldError>
{% elif note %}
  <p id="{{ id }}-note" class="field-note">{{ note }}</p>
{% endif %}

{#def game, current: str #}
{# The views of a game's hot deals: the rotation, the admin's own offers and the game's home
   screen. #}
{% set base = url("/admin/store/" ~ game.id ~ "/deals") %}
<nav aria-label="{{ _('web.admin.deals.views') }}"
     class="tabs prices-tabs">
  {% for view, path in [("rotation", ""), ("offers", "/offers"), ("home", "/home")] %}
    <Tab :href="base ~ path" :label="_('web.admin.deals.view.' ~ view)" :current="current == view" />
  {% endfor %}
</nav>

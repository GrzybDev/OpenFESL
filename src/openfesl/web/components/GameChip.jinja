{#def of, full: bool = False #}
{# The small chip on the admin panel's rows that names a row's game, in the game's own accent; a
   full chip gives the game's whole name. #}
<span data-game="{{ of.id }}"
      class="game-chip{% if full %} game-chip-full{% endif %}">{{ of.name if full else _("games." ~ of.id ~ ".short") }}</span>

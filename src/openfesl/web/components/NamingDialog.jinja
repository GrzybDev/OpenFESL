{#def rules, look, roster, name: str, refused: str, kits: dict, slot: int, who: str #}
{# The creator's naming step, a dialog that I'm done opens: the class and faction, the name
   checked as it is typed, the slot, the default hero and the starting kit. Without scripts it is
   the creator's last part, and Create hero sends the form. #}
{% set hero_class = rules.classes[look.hero_class] %}
<dialog open
        aria-labelledby="naming-title"
        data-naming
        class="site-dialog naming">
  <div class="site-dialog-box">
    <button type="button"
            data-close
            class="site-dialog-close js-only"
            aria-label="{{ _('web.dialog.close') }}">
      <Icon name="x" :size="18" stroke="currentColor" />
    </button>
    <h2 id="naming-title" class="site-dialog-title">{{ _("web.creator.naming") }}</h2>
    <p class="naming-who">
      <span aria-hidden="true"
            class="naming-disc"><Icon :name="hero_class.glyph" :size="20" stroke="currentColor" /></span>
      <span data-who>{{ who }}</span>
    </p>
    <label for="hero-name" class="naming-label">{{ _("web.creator.name") }}</label>
    <input id="hero-name"
           name="name"
           type="text"
           required
           minlength="{{ rules.name_length[0] }}"
           maxlength="{{ rules.name_length[1] }}"
           pattern="{{ rules.name }}"
           autocomplete="off"
           spellcheck="false"
           aria-describedby="name-hint name-status"
           {% if refused in ("format", "taken") %} aria-invalid="true"{% endif %}
           value="{{ name }}"
           class="naming-input">
    <p id="name-hint" class="naming-hint">{{ _("web.creator.name.hint") }}</p>
    {% set check = {"format": "format", "taken": "refused"}.get(refused, "") %}
    <NameStatus :name="name" :check="check" />
    <dl class="site-facts">
      <dt>{{ _("web.creator.slot") }}</dt>
      <dd>
        {{ _("web.creator.slot.of", slot=slot, slots=roster.slots) }}
      </dd>
      <dt>{{ _("web.creator.default") }}</dt>
      <dd>
        {% if roster.default %}
          {{ _("web.creator.default.stays", hero=roster.default.persona.name) }}
        {% else %}
          {{ _("web.creator.default.becomes") }}
        {% endif %}
      </dd>
      <dt>{{ _("web.creator.kit") }}</dt>
      <dd>
        <ul class="naming-kits">
          {% for key, kit in kits.items() %}
            <li data-kit="{{ key }}"
                {% if key != look.faction ~ "." ~ look.hero_class %} data-other{% endif %}>
              {% set faction_id, class_id = key.split(".") %}
              <span class="naming-kit-who">{{ _("web.creator.who", hero_class=_("games." ~ game.id ~ ".class." ~ class_id), faction=_("games." ~ game.id ~ ".faction." ~ faction_id)) }}:</span>
              {{ kit }}
            </li>
          {% endfor %}
        </ul>
      </dd>
    </dl>
    <div class="site-dialog-actions">
      <button type="submit"
              aria-describedby="create-why"
              data-create
              class="site-button site-button-go site-button-large">
        <Icon name="tick" :size="18" stroke="currentColor" />
        {{ _("web.creator.create") }}
      </button>
      <button type="button"
              data-close
              class="site-button site-button-ghost js-only">{{ _("web.creator.back") }}</button>
    </div>
    <p id="create-why" data-why class="site-dialog-why js-only"></p>
  </div>
</dialog>

{#def label: str, current: bool = False, href: str = "", name: str = "", value: str = "", count: int | None = None, state: str = "", narrow: bool = False #}
{# A toggle row of a filter panel, in the accent when it is the current choice: a link to the list
   with that choice, or a button that sends the form with it. The state, such as the order of the
   current sort, stands where the count would; narrow rows sit two to a line. #}
{% set aside = number(count) if count is not none else state %}
{% if href %}
  <a href="{{ href }}"
     {% if current %} aria-current="true"{% endif %}
     class="toggle{% if narrow %} toggle-narrow{% endif %}"><span>{{ label }}</span>{% if aside %}<span class="toggle-count">{{ aside }}</span>{% endif %}</a>
{% else %}
  <button type="submit"
          name="{{ name }}"
          value="{{ value }}"
          aria-pressed="{{ 'true' if current else 'false' }}"
          class="toggle{% if narrow %} toggle-narrow{% endif %}"><span>{{ label }}</span>{% if aside %}<span class="toggle-count">{{ aside }}</span>{% endif %}</button>
{% endif %}

{#def href: str, open: bool, key: str, name: str #}
{# The square at the end of a row's name that opens the row's details in place, where key names
   them; a link, so that it also works without scripts.
   Args: name is what the screen reader says it opens. #}
<a href="{{ href }}"
   role="button"
   aria-expanded="{{ 'true' if open else 'false' }}"
   aria-controls="details-{{ key }}"
   aria-label="{{ _('web.servers.details', name=name) }}"
   data-details
   class="details-button"><span><Icon name="down" stroke="#F4F4EE" class="details-chevron" /></span></a>

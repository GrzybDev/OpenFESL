{#def current: str = "" #}
{# The admin panel's menu bar, as a game's: the current item sits on the menu's block, and an
   item with something waiting shows how much. Catalogues shows while a served game takes one.
   Before signing in it holds the sign-in alone. #}
{% set items = [("home", "/admin/"), ("servers", "/admin/servers"), ("providers", "/admin/providers"), ("accounts", "/admin/accounts"), ("keys", "/admin/keys"), ("catalogues", "/admin/catalogues"), ("audit", "/admin/audit"), ("settings", "/admin/settings")] if viewer else [("sign_in", "/admin/sign-in")] %}
<nav aria-label="{{ _('web.admin.menu') }}" class="game-menu admin-menu">
  <ul>
    {% for item, path in items if item != "catalogues" or item in viewer.sections %}
      {% set waiting = viewer.counts.get(item, 0) if viewer else 0 %}
      <li>
        <a href="{{ url(path) }}"
           {% if item == current %} aria-current="page"{% endif %}
           class="menu-item">
          {%- if item == current %}<span aria-hidden="true" class="menu-current"></span>{% endif %}<span class="menu-label">{{ _("web.admin.menu." ~ item) }}</span>
          {%- if waiting %}<span class="menu-count">{{ number(waiting) }}<span class="sr-only"> {{ _("web.admin.menu.waiting") }}</span></span>{% endif -%}
        </a>
      </li>
    {% endfor %}
  </ul>
</nav>

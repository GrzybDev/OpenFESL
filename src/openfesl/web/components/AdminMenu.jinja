{#def current: str = "" #}
{# The admin panel's menu bar, as a game's: the current item sits on the menu's block (M2). Before
   signing in it holds the sign-in alone. #}
{% set items = [("home", "/admin/")] if viewer else [("sign_in", "/admin/sign-in")] %}
<nav aria-label="{{ _('web.admin.menu') }}" class="game-menu admin-menu">
  <ul>
    {% for item, path in items %}
      <li>
        <a href="{{ url(path) }}"
           {% if item == current %} aria-current="page"{% endif %}
           class="menu-item">
        {%- if item == current %}<span aria-hidden="true" class="menu-current"></span>{% endif %}<span class="menu-label">{{ _("web.admin.menu." ~ item) }}</span></a>
      </li>
    {% endfor %}
  </ul>
</nav>

{#def game, subtitle: str #}
{# The head of a game's rewards in the admin panel: the title with whose rewards page they are. #}
<PageHead labelledby="rewards-title">
  <div class="enter-title page-title">
    <TitleBlock :title="_('web.admin.rewards.title')" id="rewards-title">{{ subtitle }}</TitleBlock>
  </div>
</PageHead>

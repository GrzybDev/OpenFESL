{#def game, subtitle: str, current: str = "" #}
{# The head of a game's rewards in the admin panel: the title with whose rewards page they are, and
   the tabs of their views. #}
{% set base = url("/admin/rewards/" ~ game.id) %}
<PageHead labelledby="rewards-title"
          :title="_('web.admin.rewards.title')"
          :subtitle="subtitle">
  <nav aria-label="{{ _('web.admin.rewards.tabs') }}" class="tabs">
    {% for tab, path in [("rules", ""), ("preview", "/preview"), ("claims", "/claims")] %}
      <Tab :href="base ~ path" :label="_('web.admin.rewards.tab.' ~ tab)" :current="tab == current" />
    {% endfor %}
  </nav>
</PageHead>

{#def overview, made_in, said: dict, errors: dict, countries: list, games: list, game_names: list, services: list, since, sent, waits: bool, mail: bool, check: str, accepted: bool, password_games: list, personas: list, failed #}
{# The account page: the title block with the display name, the index of its parts that stays at
   the top while the page scrolls, and the parts. Each part's forms come back to it; where scripts
   run, only that part is swapped. #}
{% set account = overview.account %}
{% set title = _("web.account.page") %}
{% set parts = [
  {"id": "profile", "label": _("web.account.profile")},
  {"id": "sign-in", "label": _("web.account.index.sign_in"), "count": overview.ways_in, "noun": _n("web.account.index.ways", overview.ways_in)},
  {"id": "games", "label": _("web.account.games"), "count": games|length, "noun": _n("web.account.index.games", games|length)},
  {"id": "deletion", "label": _("web.account.deletion")},
] %}
<Layout :title="title" page="account" :turnstile="check != ''">
  <PageHead labelledby="account-title" class="account-head">
    <div class="enter-title page-title page-title-wider">
      <TitleBlock :title="title" id="account-title">{{ _("web.account.page.subtitle", name=account.display_name) }}</TitleBlock>
    </div>
    <p class="account-intro">{{ _("web.account.page.intro") }}</p>
  </PageHead>
  <AccountIndex :parts="parts" />
  <div class="enter-panel account-parts">
    <AccountProfile :overview="overview" :made_in="made_in" :said="said if said.get('part') == 'profile' else {}" :errors="errors" :countries="countries" :sent="sent" :waits="waits" :mail="mail" :check="check" :accepted="accepted" :password_games="password_games" :personas="personas" />
    <AccountSecurity :overview="overview" :said="said if said.get('part') == 'sign-in' else {}" :errors="errors" :games="game_names" :services="services" :mail="mail" :since="since" :password_games="password_games" />
    <AccountGames :games="games" :password="overview.password" />
    <AccountDeletion :overview="overview" :said="said if said.get('part') == 'deletion' else {}" :personas="personas" />
  </div>
  <template id="toast-failed">
    <Toast :shown="failed" />
  </template>
</Layout>

{#def account, error: str, notice: str, personas: list #}
{# The page a reset link opens, which needs no sign-in: the account the link proves, named, and its
   new game password. #}
<AccountPage :title="_('web.account.reset.new')"
             :subtitle="_('web.account.reset.subtitle')">
  <div class="account-page-main">
    <Panel tag="form"
           method="post"
           :action="here"
           aria-labelledby="reset-new"
           class="enter-panel account-page-panel">
      <CsrfField />
      {% if notice == "form" %}
        <Alert :label="_('web.account.notice.not_saved')" :title="_('web.account.notice.form')" glyph="warn" alert>{{ _("web.account.notice.form.text") }}</Alert>
      {% endif %}
      <div class="account-page-form">
        <Bar tag="h3">{{ _("web.account.reset.account") }}</Bar>
        <dl class="facts">
          {% if account.display_name %}
            <Fact :label="_('web.account.display_name')" plain>
              {{ account.display_name }}
            </Fact>
          {% endif %}
          <Fact :label="_('web.account.address')" plain>
            {{ account.nuid }}
          </Fact>
        </dl>
      </div>
      <div class="account-page-form">
        <Bar id="reset-new" tag="h3" large>{{ _("web.account.reset.new") }}</Bar>
        <PasswordField id="reset-password"
                       :label="_('web.account.reset.new')"
                       note="reset-password-note"
                       :error="error"
                       :focus="error != ''"
                       new>
          <p id="reset-password-note" class="field-note">{{ _("web.account.reset.password") }}</p>
        </PasswordField>
        <ActionButton :label="_('web.account.reset.save')" :busy="_('web.account.reset.busy')" />
      </div>
    </Panel>
  </div>
  <div class="account-page-side">
    <ResetChanges :personas="personas" />
  </div>
</AccountPage>

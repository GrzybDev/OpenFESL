{#def rules, roster, look, name: str, refused: str, notice: str, from_game: bool, kits: dict, next: str, figure: dict | None #}
{# The hero creator: why the game opened it, the slots, and the one-screen creator, or why no hero
   can be created now. #}
{% set title = _("web.creator.title") %}
{% set slot = roster.heroes|length + 1 if roster else 1 %}
<Layout :title="title">
  {% if refused == "taken" %}
    <SiteMessage :shown="{'key': 'web.creator.refused.taken', 'values': {'name': name}, 'error': True}" />
  {% elif notice == "form" %}
    <SiteMessage :shown="{'key': 'web.creator.refused.form', 'values': {}, 'error': True}" />
  {% endif %}
  {% if from_game %}<ArrivalNotice :roster="roster" :next="next" />{% endif %}
  <section aria-labelledby="creator-title" class="creator-head">
    <div class="creator-intro">
      <Plaque id="creator-title">{{ title }}</Plaque>
      {% if player and not roster.free %}
        <p class="site-lead">{{ _("web.creator.lead.full") }}</p>
      {% elif player %}
        <p class="site-lead">
          {{ _("web.creator.lead") }}
          {% if not roster.default %}{{ _("web.creator.lead.first") }}{% endif %}
          {{ _("web.creator.lead.kept", cost=cost(rules.rename_price, _("games." ~ game.id ~ ".currency." ~ rules.currency), rules.rename_sale)) }}
        </p>
      {% endif %}
      {% if roster and roster.heroes %}
        <a href="{{ url('/' ~ game.id ~ '/heroes') }}"
           class="site-link"><Icon name="back" :size="13" stroke="currentColor" />{{ _("web.heroes.back") }}</a>
      {% endif %}
    </div>
    {% if player %}
      <SlotPanel :roster="roster" :taking="slot if roster.free else 0">
      {% if roster.free %}
        {{ _("web.slots.taking", slot=slot) }}
      {% else %}
        {{ _n("web.slots.free", rules.slots) }}
        {{ _("web.slots.further", cost=cost(rules.slot_price, _("games." ~ game.id ~ ".currency." ~ rules.currency), rules.slot_sale)) }}
      {% endif %}
      </SlotPanel>
    {% endif %}
  </section>
  {% if not player and from_game %}
    <p class="creator-waiting">{{ _("web.creator.waiting") }}</p>
  {% elif not player %}
    <section aria-labelledby="creator-closed"
             class="creator-closed creator-unavailable">
      <span aria-hidden="true"
            class="creator-unavailable-disc"><Icon name="sign-in" :size="34" stroke="#0A0A0A" /></span>
      <div class="creator-unavailable-text">
        <h2 id="creator-closed" class="site-box-title">{{ _("web.creator.signed_out") }}</h2>
        <p>{{ _("web.creator.signed_out.text") }}</p>
        <p class="site-actions">
          <a href="{{ url('/sign-in') }}?{{ {'next': next}|urlencode }}"
             class="site-button site-button-go site-button-large"><Icon name="sign-in" :size="18" stroke="currentColor" />{{ _("web.account.sign_in.action") }}</a>
          <a href="{{ url('/register') }}"
             class="site-link">{{ _("web.account.sign_in.create") }}<Icon name="go" :size="12" stroke="currentColor" /></a>
        </p>
      </div>
    </section>
  {% elif not roster.free %}
    {% set price = rules.slot_price %}
    {% set short = bar.funds < price %}
    {% set currency = _("games." ~ game.id ~ ".currency." ~ rules.currency) %}
    <section aria-labelledby="creator-closed"
             class="creator-closed creator-unavailable">
      <span aria-hidden="true"
            class="creator-unavailable-disc creator-unavailable-coin"><Icon name="coin" :size="34" stroke="#0A0A0A" /></span>
      <div class="creator-unavailable-text">
        <h2 id="creator-closed" class="site-box-title">{{ _n("web.creator.full", roster.slots) }}</h2>
        <p>{{ _("web.creator.full.text", cost=cost(price, currency, rules.slot_sale)) }}</p>
        <p class="creator-amounts">
          <span>{{ _("web.rename.price") }}</span> <strong><SalePrice :sale="rules.slot_sale" :price="number(price) ~ ' ' ~ currency" /></strong> ·
          <span>{{ _("web.rename.funds_now", currency=currency) }}</span>
          <strong{% if short %} class="site-short"{% endif %}>{{ number(bar.funds) }}{% if short %} · {{ _("web.rename.short", amount=number(price - bar.funds)) }}{% endif %}</strong>
        </p>
        <p class="site-actions">
          <BuySlotButton :why="'creator-why' if short else ''" plus />
          <a href="{{ url('/' ~ game.id ~ '/heroes') }}"
             class="site-link"><Icon name="back" :size="13" stroke="currentColor" />{{ _("web.heroes.back") }}</a>
          {% if short %}
            <FundsLink class="site-link"><Icon name="go" :size="12" stroke="currentColor" /></FundsLink>
          {% endif %}
        </p>
        {% if short %}
          <p id="creator-why" class="creator-why">
            <Icon name="warn" :size="18" stroke="currentColor" />
            {{ _("web.slots.why.funds", funds=number(bar.funds), price=number(price), currency=currency) }}
          </p>
        {% endif %}
      </div>
    </section>
  {% else %}
    <CreatorForm :rules="rules" :look="look" :roster="roster" :name="name" :refused="refused" :from_game="from_game" :kits="kits" :slot="slot" :figure="figure" />
  {% endif %}
</Layout>

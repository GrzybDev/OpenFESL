{#def hero, player, title: str | None, rank: tuple | None, unranked: bool, equipped: list, facts: list, played: bool, imported: bool, lists: dict, moments: list, missions: list #}
{# A hero's public profile, as the 2012 site drew it: the head with the hero's picture, faction,
   class, level, prestige rank and player; what it wears and has on its equipment bar; and its
   Soldier Info, the stats of its rounds with its place on the all-time score board, or that it
   has yet to play the time the board asks for, which a hero without rounds shows empty with when
   they fill; then the weapons it used and those that defeated it, its maps and vehicles, its
   heroic moments and its missions, which come with its rounds. #}
{% set rules = game.heroes %}
{% set name = hero.persona.name %}
<Layout :title="name">
  <div class="profile"
       {% if hero.faction %}data-faction="{{ hero.faction }}"{% endif %}>
    <section aria-labelledby="profile-name" class="profile-head enter-title">
      <HeroMugshot :hero="hero" />
      <div class="profile-who">
        {% if hero.faction %}
          <p class="profile-faction">
            <Icon :name="rules.factions[hero.faction].glyph" :size="16" stroke="currentColor" />
            {{ _("games." ~ game.id ~ ".faction." ~ hero.faction) }}
          </p>
        {% endif %}
        <h1 id="profile-name" class="profile-name">{{ name }}</h1>
        <p class="profile-kind">
          {% if hero.hero_class %}
            <span aria-hidden="true"
                  class="friend-disc"><Icon :name="rules.classes[hero.hero_class].glyph" :size="20" stroke="currentColor" /></span>
            {{ _("games." ~ game.id ~ ".class." ~ hero.hero_class) }}
          {% endif %}
          <span class="search-level"><span class="sr-only">{{ _("web.bar.level") }}</span>{{ hero.level }}</span>
        </p>
        <p class="profile-player">
          {% if title %}<span class="profile-title">{{ title }}</span> ·{% endif %}
          {% set link %}<PlayerLink :account_id="player.id" :name="player.display_name" />{% endset %}
          {{ _("web.hero.player", player=link) }}
        </p>
      </div>
    </section>
    <div class="profile-columns">
      <section aria-labelledby="profile-equipped" class="profile-equipped">
        <h2 id="profile-equipped" class="profile-label">{{ _("web.hero.equipped") }}</h2>
        <ul role="list" class="profile-items enter-rows">
          {% for item in equipped %}
            <li class="profile-item">
              <span aria-hidden="true" class="profile-icon">
                {% if item.icon %}
                  <img src="{{ item.icon }}" alt="" loading="lazy" decoding="async">
                {% elif item.glyph %}
                  <Icon :name="item.glyph" :size="26" stroke="#3B2D23" />
                {% else %}
                  <span class="profile-unknown">?</span>
                {% endif %}
              </span>
              <span class="profile-item-name">
                {{ item.name or _("web.hero.item", number=item.id) }}
                {% if item.level %}<span class="profile-item-level">{{ _("web.heroes.level", level=item.level) }}</span>{% endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
        {% if not imported %}
          <p class="profile-missing">
            <span aria-hidden="true" class="profile-unknown">?</span>{{ _("web.hero.missing") }}
          </p>
        {% endif %}
      </section>
      <section aria-labelledby="profile-info"
               class="info-box info-box-red profile-info enter-panel">
        <h2 id="profile-info" class="info-box-title">{{ _("web.hero.info") }}</h2>
        {% if not played %}
          <p class="profile-none">
            <Icon name="clock" :size="18" stroke="currentColor" />{{ _("web.hero.no_rounds", hero=name) }}
          </p>
        {% endif %}
        <dl class="profile-facts">
          {% for fact in facts %}
            <div>
              <dt>{{ _("web.hero.fact." ~ fact.name) }}</dt>
              <dd>
                {%- if fact.value is none %}–{% elif fact.value is string %}{{ fact.value }}{% else %}{{ when(fact.value, "yMMMd") }}{% endif -%}
                {%- if fact.name == "score" and rank %}
                  · <a href="{{ rank[1] }}">{{ _("web.hero.rank", place=number(rank[0])) }}</a>
                {% elif fact.name == "score" and unranked %}
                  · {{ _("web.hero.unranked") }}
                {% endif -%}
              </dd>
            </div>
          {% endfor %}
        </dl>
        <p class="info-box-note">
          {{ _("web.player.reported") }}
          {% if rank %}{{ _("web.hero.rank.ranked", time=when(rank[2], "Hm") ~ " UTC") }}{% endif %}
        </p>
      </section>
    </div>
    {% if played and lists.values()|select|list %}
      {% set glyphs = {"weapons": "weapon", "foes": "weapon", "maps": "compass", "vehicles": "wheel"} %}
      <section aria-labelledby="profile-played"
               class="info-box info-box-green profile-played enter-panel">
        <h2 id="profile-played" class="info-box-title">{{ _("web.hero.played") }}</h2>
        {% for kind, rows in lists.items() if rows %}
          <h3 class="profile-list-title">{{ _("web.hero.list." ~ kind) }}</h3>
          <ul role="list" class="profile-rows">
            {% for row in rows %}
              <li class="profile-row">
                <span aria-hidden="true" class="profile-icon">
                  {% if row.icon %}
                    <img src="{{ row.icon }}" alt="" loading="lazy" decoding="async">
                  {% else %}
                    <Icon :name="glyphs[kind]" :size="26" stroke="#3B2D23" />
                  {% endif %}
                </span>
                <div class="profile-row-text">
                  <p class="profile-row-name">{{ row.name }}</p>
                  <dl class="profile-row-stats">
                    {% for label, value in row.stats %}
                      <div>
                        <dt>{{ label }}</dt>
                        <dd>
                          {{ value }}
                        </dd>
                      </div>
                    {% endfor %}
                  </dl>
                </div>
              </li>
            {% endfor %}
          </ul>
        {% endfor %}
      </section>
    {% endif %}
    {% if played %}
      <div class="profile-columns">
        {% if moments %}
          <section aria-labelledby="profile-moments">
            <h2 id="profile-moments" class="site-heading">{{ _("web.hero.moments") }}</h2>
            <ul role="list" class="profile-moments enter-rows">
              {% for moment in moments %}
                <li class="profile-moment">
                  <span aria-hidden="true" class="profile-star"><Icon name="star" :size="14" stroke="#0A0A0A" /></span>
                  {{ moment.name }} · <strong>{{ moment.stats[0][1] }}</strong>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
        {% if missions %}
          <section aria-labelledby="profile-missions">
            <h2 id="profile-missions" class="site-heading">{{ _("web.hero.missions") }}</h2>
            <ul role="list" class="profile-missions">
              {% for mission in missions %}
                <li class="profile-mission">
                  <span aria-hidden="true" class="profile-mission-icon">
                    {% if mission.icon %}
                      <img src="{{ mission.icon }}" alt="" loading="lazy" decoding="async">
                    {% else %}
                      <Icon name="flag" :size="18" stroke="currentColor" />
                    {% endif %}
                  </span>
                  <p>
                    <strong>{{ mission.name }}</strong> · {{ mission.stats[0][1] }}
                  </p>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      </div>
    {% endif %}
  </div>
</Layout>

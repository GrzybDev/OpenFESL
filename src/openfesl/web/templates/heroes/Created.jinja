{#def roster, hero, slot: int, kit: str, from_game: bool #}
{# The page a new hero arrives on: what was created, where it stands and what follows, beside the
   new hero's card. #}
{% set title = _("web.created.title") %}
{% set name = hero.persona.name %}
{% set default = roster.default %}
<Layout :title="title">
  <section aria-labelledby="created-title" class="creator-head">
    <div class="creator-intro">
      <Plaque id="created-title">{{ title }}</Plaque>
    </div>
    <SlotPanel :roster="roster">{{ _("web.created.slot", hero=name, slot=slot) }}</SlotPanel>
  </section>
  <div class="created">
    <section aria-labelledby="created-what"
             class="site-box site-box-green created-box enter-panel">
      <span aria-hidden="true" class="created-disc"><Icon name="tick" :size="48" stroke="#0A0A0A" /></span>
      <div class="created-text">
        <h2 id="created-what" class="site-box-title">{{ _("web.created.what", hero=name) }}</h2>
        {% if default and default.persona.id == hero.persona.id %}
          <p>{{ _("web.created.default", hero=name, slot=slot, slots=roster.slots) }}</p>
          <p>{{ _("web.created.from_game" if from_game else "web.created.logs_in", game=game.name, hero=name) }}</p>
        {% else %}
          <p>{{ _("web.created.further", slot=slot, slots=roster.slots, game=game.name) }}</p>
          {% if default %}<p>{{ _("web.created.stays", hero=default.persona.name, game=game.name) }}</p>{% endif %}
        {% endif %}
        {% if kit %}<p class="created-kit">{{ _("web.created.kit", kit=kit) }}</p>{% endif %}
        {% if roster.free %}
          <p class="site-actions">
            <a href="{{ url('/' ~ game.id ~ '/user/createHero') }}"
               class="site-button"><Icon name="plus" :size="16" stroke="#FEDE01" />{{ _("web.created.another") }}</a>
          </p>
        {% endif %}
      </div>
    </section>
    <HeroSummary :hero="hero" :slot="slot" :slots="roster.slots" :default="default and default.persona.id == hero.persona.id" />
  </div>
</Layout>

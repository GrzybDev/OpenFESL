{#def view, line, back: str, form #}
{# A grant to a wallet or a take from it, as a page of its own: whose wallet it is, Grant
   or Take, the amount and the balance after, which a take below 0 or a balance past what the
   game reads makes not possible. Where scripts run, it opens as a dialog over its page. #}
{% set account = view.record.account %}
{% set game = line.wallet.game %}
{% set code = line.wallet.currency %}
{% set currency = _("games." ~ game ~ ".currency." ~ code) %}
{% set owner = line.hero.persona.name if line.hero else account.nuid %}
{% set title = _("web.admin.wallets.title") %}
{% set error = form.get("error", "") %}
{% set most = 2147483647 %}
{% set fewer = _("web.admin.wallets.refused.below", wallet=currency, balance=number(line.balance)) %}
{% if error == "amount" %}
  {% set why = _("web.admin.still_needed", what=_("web.admin.still_needed.amount")) %}
{% elif error == "fewer" %}
  {% set why = fewer %}
{% elif error == "more" %}
  {% set why = _("web.admin.wallets.refused.max", after=number(line.balance + form.get("amount")|int), max=number(most)) %}
{% else %}
  {% set why = "" %}
{% endif %}
<AdminPage :title="title ~ ' · ' ~ owner" current="accounts">
  <PageHead labelledby="wallet-title">
    <div class="enter-title page-title">
      <TitleBlock :title="title" id="wallet-title">{{ owner }}</TitleBlock>
    </div>
  </PageHead>
  <Panel class="enter-panel confirm-frame">
    <AdminForm :question="_('web.admin.wallets.dialog', currency=currency)" :action="url('/admin/accounts/' ~ account.id ~ '/wallets/' ~ game ~ '/' ~ line.key)" :label="_('web.admin.wallets.dialog.submit')" :busy="_('web.admin.count.busy')" :back="back" :note="form.get('note', '')" :error="error" :why="why">
    <p class="confirm-account">
      <span>{{ owner }}</span>
      <span>{{ code }} · {{ _("web.admin.hero.heading", id=line.hero.persona.id) if line.hero else _("web.admin.account.number", number=account.id) }}</span>
    </p>
    {% if not line.head.opened and line.wallet.allowance %}
      <p class="bar-text body-text">{{ _("web.admin.wallets.closed.text", amount=number(line.wallet.allowance), currency=currency) }}</p>
    {% endif %}
    <CountFields :now="line.balance" :most="most" :label="_('web.admin.wallets.dialog.amount', currency=currency)" :fewer="fewer" :more="_('web.admin.wallets.refused.max', max=number(most), after='%(after)s')" :chosen="form.get('direction', 'grant')" :amount="form.get('amount', '')" />
    <p id="confirm-text" class="body-text">
      {{ _("web.admin.wallets.dialog.points") if line.hero else _("web.admin.wallets.dialog.text") }}
    </p>
    </AdminForm>
  </Panel>
</AdminPage>

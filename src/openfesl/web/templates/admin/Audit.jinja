{#def listing, rows: list, total: int, pages: int, size: int, auditors: list, account #}
{# The log of the admin's actions, newest first: when, who, what was done to what with a link to
   it, and what changed, beside the filter by admin. An account's own log also lists what was
   done to its in-game names. #}
{% set title = _("web.admin.audit") %}
{% set list = url("/admin/audit") %}
{% set everyone = auditors|sum(attribute="count") %}
{% macro who(subject, name, role) %}
  {%- if subject is none %}{{ _("web.admin.command_line") }}{% else %}{{ name or subject }}{% endif -%}
{% endmacro %}
<AdminPage :title="title" current="audit">
  <PageHead labelledby="audit-title">
    <div class="enter-title page-title">
      <TitleBlock :title="title" id="audit-title">{{ _("web.admin.audit.subtitle") }}</TitleBlock>
    </div>
    {% if listing.account is not none %}
      <Tab :href="list" class="tab-back tab-link"><Icon name="go" :size="14" stroke="currentColor" class="go" />{{ _("web.admin.audit.whole") }}</Tab>
    {% endif %}
  </PageHead>
  <Panel class="enter-panel">
    <div class="list-layout admin-layout">
      <section aria-labelledby="audit-list" class="list-main admin-list">
        <h2 id="audit-list" class="sr-only">{{ _("web.admin.audit.list") }}</h2>
        {% if listing.account is not none %}
          <p class="bar audit-account">
            <span>{{ _("web.admin.audit.account", number=listing.account, name=account) if account else _("web.admin.account.number", number=listing.account) }}</span>
            <a href="{{ url('/admin/accounts/' ~ listing.account) }}"
               class="bar-extra">{{ _("web.admin.account.page") }}</a>
          </p>
        {% endif %}
        <div class="table-scroll table-scroll-flush">
          <div role="table" aria-labelledby="audit-list" class="table">
            <div role="rowgroup" class="admin-list-head">
              <div role="row" class="audit-columns">
                <div role="columnheader"
                     class="column-head"><span class="sr-only">{{ _("web.admin.audit.kind") }}</span></div>
                <div role="columnheader"
                     aria-sort="descending"
                     class="column-head column-sorted">
                  {{ _("web.admin.audit.time") }}<Icon name="down" :size="14" stroke="currentColor" />
                </div>
                <div role="columnheader" class="column-head">{{ _("web.admin.audit.admin") }}</div>
                <div role="columnheader" class="column-head column-name">{{ _("web.admin.audit.action") }}</div>
                <div role="columnheader" class="column-head">{{ _("web.admin.audit.details") }}</div>
                <div role="columnheader"><span class="sr-only">{{ _("web.admin.audit.target") }}</span></div>
              </div>
            </div>
            <div role="rowgroup" class="enter-rows table-rows">
              {% for row in rows %}
                {% set entry = row.entry %}
                <div role="row" class="audit-columns audit-row">
                  <div role="cell" class="admin-cell admin-badges">
                    <span aria-hidden="true"
                          class="badge"><Icon :name="row.glyph" stroke="#0A0A0A" fill="#0A0A0A" /></span>
                  </div>
                  <div role="cell" class="admin-cell cell-stack">
                    <span aria-hidden="true" class="cell-label">{{ _("web.admin.audit.time") }}</span>
                    <span class="cell-time">{{ _("web.server.time", time=when(entry.at, "Hm")) }}</span>
                    <span class="cell-ago">{{ when(entry.at, "MMMd") }} · {{ ago(entry.at) }}</span>
                  </div>
                  <div role="cell" class="admin-cell cell-stack">
                    <span aria-hidden="true" class="cell-label">{{ _("web.admin.audit.admin") }}</span>
                    <span class="audit-who">{{ who(entry.admin, entry.name, entry.role) }}</span>
                    {% if entry.role %}<span class="audit-role">{{ _("web.admin.role." ~ entry.role) }}</span>{% endif %}
                  </div>
                  <div role="cell" class="admin-cell cell-stack audit-action">
                    <span class="audit-title">{{ row.title }}</span>
                    {% if row.href %}
                      <a href="{{ row.href }}"
                         class="audit-target{% if row.code %} audit-code{% endif %}">{{ row.target }}</a>
                    {% else %}
                      <span class="audit-target{% if row.code %} audit-code{% endif %}">{{ row.target }}</span>
                    {% endif %}
                  </div>
                  <div role="cell" class="admin-cell audit-details">
                    <span aria-hidden="true"
                          class="cell-label">{{ _("web.admin.audit.details") }}</span>{{ row.details or "–" }}
                  </div>
                  <div role="cell" class="cell-end">
                    {% if row.href %}<EndSquare :href="row.href" :label="_('web.admin.audit.open', target=row.target)" />{% endif %}
                  </div>
                </div>
              {% else %}
                <div role="row">
                  <div role="cell" aria-colspan="6" class="row-details list-empty">
                    <div>
                      <p class="list-empty-title">{{ _("web.admin.audit.none." ~ ("filtered" if listing.admin is not none or listing.account is not none else "all")) }}</p>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="list-foot">
          <p>
            <span class="list-count">{{ _("web.admin.audit.count", count=number(total)) }}</span><span class="list-range">{{ _("web.admin.audit.order", count=number(size)) }}</span>
          </p>
          <Pager :base="list" :view="listing" :pages="pages" />
        </div>
      </section>

      <div class="list-side admin-side">
        <nav aria-labelledby="audit-who" class="audit-filter">
          <h2 id="audit-who" class="bar bar-large">
            <span>{{ _("web.admin.audit.filter") }}</span>
          </h2>
          <ul>
            <li>
              <a href="{{ list ~ listing.changed(admin=None, page=1).query() }}"
                 {% if listing.admin is none %} aria-current="true"{% endif %}
                 class="toggle audit-person"><span>{{ _("web.admin.audit.everyone") }}</span><span class="toggle-count">{{ number(everyone) }}</span></a>
            </li>
            {% for auditor in auditors %}
              {% set subject = auditor.subject if auditor.subject is not none else "" %}
              <li>
                <a href="{{ list ~ listing.changed(admin=subject, page=1).query() }}"
                   {% if listing.admin == subject %} aria-current="true"{% endif %}
                   class="toggle audit-person"><span class="audit-person-name">
                  <span>{{ who(auditor.subject, auditor.name, auditor.role) }}</span>
                  {% if auditor.role %}<span class="audit-role">{{ _("web.admin.role." ~ auditor.role) }}</span>{% endif %}
                </span><span class="toggle-count">{{ number(auditor.count) }}</span></a>
              </li>
            {% endfor %}
          </ul>
        </nav>
        <p class="body-text side-note">{{ _("web.admin.audit.note") }}</p>
      </div>
    </div>
  </Panel>
</AdminPage>

{#def of, catalogue, row, lines: list, rule: str, manages: bool #}
{# An item's prices in a game's store: its kind, which heroes may have it and its rule,
   then each price point with its product's id, currency, ownership, price, whether the price is
   the rule's or the item's own, and whether it is sold. An ability's levels are its steps, at the
   fixed price of the heroes' points. #}
{% set game = of %}
{% set item = row.prices.item %}
{% set state = row.prices.state.value %}
{% set fixed = row.prices.fixed %}
{% set list = url("/admin/store/" ~ game.id) %}
{% set levels = item.levels or [item.id] %}
<AdminPage :title="row.name ~ ' · ' ~ _('web.admin.store.title')"
           current="store">
  <StoreHead :game="game" current="prices" :subtitle="_('web.admin.store.subtitle', game=game.name)" />
  <Panel class="enter-panel">
    <nav aria-label="{{ _('web.admin.store.items') }}"
         class="tabs prices-back">
      <Tab :href="list" class="tab-back tab-link"><Icon name="go" :size="14" stroke="currentColor" class="go" />{{ _("web.admin.store.all_items") }}</Tab>
    </nav>
    <div class="list-layout admin-layout">
      <div class="list-main prices-item-main">
        <section aria-labelledby="prices-item" class="account-part">
          <h2 id="prices-item" class="bar bar-wrap prices-item-bar">
            <span class="prices-item-title">{{ row.name }}<span class="prices-item-number">{{ _("web.admin.items.number", id=item.id) }}</span></span>
            <span class="bar-extra">{{ _("web.admin.store.state." ~ state) }}</span>
          </h2>
          <dl class="facts prices-facts">
            <Fact :label="_('web.admin.store.fact.kind')" plain>
              {{ _("games." ~ game.id ~ ".item_kind." ~ item.kind) }}
            </Fact>
            <Fact :label="_('web.admin.store.fact.requires')" plain>
              {{ row.requires }}
            </Fact>
            <Fact :label="_('web.admin.store.fact.rule')" plain>
              {{ rule }}
            </Fact>
          </dl>
          {% if row.prices.unsold %}
            <p class="bar-text prices-unsold">
              <span aria-hidden="true" class="badge"><Icon name="lock" :size="14" stroke="#0A0A0A" /></span><span>{{ row.ways }} · {{ _("web.admin.store.unsold.text." ~ row.prices.unsold.value) }}</span>
            </p>
          {% endif %}
        </section>

        <section aria-labelledby="prices-points" class="account-part">
          <Bar id="prices-points" :extra="_n('web.admin.store.points.own', lines|selectattr('own')|list|length, total=number(lines|length))">{{ _("web.admin.store.points") }}</Bar>
          {% if lines %}
            <div class="table-scroll">
              <div role="table"
                   aria-labelledby="prices-points"
                   class="table prices-points-table">
                <div role="rowgroup">
                  <div role="row" class="prices-point-columns">
                    <div role="columnheader" class="column-head">{{ _("web.admin.store.point.column.product") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.store.point.column.currency") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.store.point.column.ownership") }}</div>
                    <div role="columnheader"
                         class="column-head column-number">{{ _("web.admin.store.point.column.price") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.store.point.column.from") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.store.point.column.sold") }}</div>
                  </div>
                </div>
                <div role="rowgroup" class="enter-rows table-rows">
                  {% for line in lines %}
                    {% set product = line.product %}
                    {% set ownership = product.ownership %}
                    <div role="row" class="prices-point-columns prices-point-row">
                      <div role="cell" class="admin-cell prices-product">{{ game.store.product_id(product.id) }}</div>
                      <div role="cell" class="admin-cell prices-currency">
                        <span aria-hidden="true"
                              class="cell-label">{{ _("web.admin.store.point.column.currency") }}</span>
                        {{ _("games." ~ game.id ~ ".currency." ~ product.currency) }}
                      </div>
                      <div role="cell" class="admin-cell">
                        <span aria-hidden="true"
                              class="cell-label">{{ _("web.admin.store.point.column.ownership") }}</span>
                        {% if fixed %}
                          {{ _("web.admin.store.step", step=number(levels.index(product.item_id) + 1), steps=number(levels|length)) }}
                        {% elif ownership.type == "tlmd" %}
                          {{ _n("web.store.price.days", ownership.days) }}
                        {% elif ownership.type == "lmct" %}
                          {{ _n("web.store.price.uses", ownership.uses) }}
                        {% else %}
                          {{ _("web.store.price.permanent") }}
                        {% endif %}
                      </div>
                      <div role="cell" class="admin-cell prices-price">{{ number(product.price) }}</div>
                      <div role="cell" class="admin-cell cell-stack">
                        <span aria-hidden="true" class="cell-label">{{ _("web.admin.store.point.column.from") }}</span>
                        {% if fixed %}
                          <span class="prices-from">{{ _("web.admin.store.state.fixed") }}</span>
                        {% elif line.own %}
                          <span class="prices-from">{{ _("web.admin.store.point.own") }}</span>
                          <span class="cell-ago">{{ _("web.admin.store.point.rule_value", price=number(line.rule)) if line.rule else _("web.admin.store.point.no_rule") }}</span>
                        {% else %}
                          <span class="prices-from">{{ _("web.admin.store.point.rule") }}</span>
                        {% endif %}
                      </div>
                      <div role="cell" class="admin-cell prices-state">
                        <Badge :name="'tick' if product.published else 'x'" lines />{{ _("web.admin.store.point.on" if product.published else "web.admin.store.point.off") }}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% else %}
            <p class="bar-text body-text">{{ _("web.admin.store.points.empty") }}</p>
          {% endif %}
          {% if fixed %}
            <p class="bar-text body-text">{{ _("web.admin.store.ability") }}</p>
          {% elif not manages %}
            <p class="bar-text account-role-note">
              <span aria-hidden="true"
                    class="badge"><Icon name="guard" :size="14" fill="#0A0A0A" /></span>{{ _("web.admin.store.managed") }}
            </p>
          {% endif %}
        </section>
      </div>
      <div class="list-side admin-side">
        <section aria-labelledby="prices-item-note">
          <Bar id="prices-item-note">{{ _("web.admin.store.keep.title") }}</Bar>
          <p class="bar-text body-text">{{ _("web.admin.store.keep_products") }}</p>
        </section>
      </div>
    </div>
  </Panel>
</AdminPage>

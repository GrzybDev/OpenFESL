{#def of, catalogue, row, lines: list, rule: str, manages: bool, adding, form: dict = {}, refused: str = "", refused_point: int | None = None, why: str = "" #}
{# An item's prices in a game's store: its kind, which heroes may have it and its
   rule, then each price point with its product's id, currency, ownership, price, whether the price
   is the rule's or the item's own, and whether it is sold. Admins change the prices and what is
   sold, switch the item off, add a price point or reset the points to the rule; a refusal stands
   beside its row or the add panel and nothing is saved. The add panel's fields belong to a form of
   their own, so that Enter in them adds the point. An ability's levels are its steps, at the fixed
   price of the heroes' points. #}
{% set game = of %}
{% set item = row.prices.item %}
{% set state = row.prices.state.value %}
{% set fixed = row.prices.fixed %}
{% set list = url("/admin/store/" ~ game.id) %}
{% set here = list ~ "/items/" ~ item.id %}
{% set levels = item.levels or [item.id] %}
{% set editable = manages and not fixed and not row.prices.unsold %}
{% set saving = form if refused_point is not none else {} %}
{% set unsold = saving.get("unsold") if saving else state == "off" and lines %}
{% macro refusal(text) %}
  <p role="alert" class="prices-refusal">
    <span aria-hidden="true" class="badge"><Icon name="warn" :size="14" fill="#0A0A0A" /></span><span>{{ text }}</span>
  </p>
{% endmacro %}
<AdminPage :title="row.name ~ ' · ' ~ _('web.admin.store.title')"
           current="store">
  <StoreHead :game="game" current="prices" :subtitle="_('web.admin.store.subtitle', game=game.name)" />
  <Panel class="enter-panel">
    <nav aria-label="{{ _('web.admin.store.items') }}"
         class="tabs prices-back">
      <Tab :href="list" class="tab-back tab-link"><Icon name="go" :size="14" stroke="currentColor" class="go" />{{ _("web.admin.store.all_items") }}</Tab>
    </nav>
    <div class="list-layout admin-layout">
      <div class="list-main prices-item-main">
        <section aria-labelledby="prices-item" class="account-part">
          <h2 id="prices-item" class="bar bar-wrap prices-item-bar">
            <span class="prices-item-title">{{ row.name }}<span class="prices-item-number">{{ _("web.admin.items.number", id=item.id) }}</span></span>
            <span class="bar-extra">{{ _("web.admin.store.state." ~ state) }}</span>
          </h2>
          <dl class="facts prices-facts">
            <Fact :label="_('web.admin.store.fact.kind')" plain>
              {{ _("games." ~ game.id ~ ".item_kind." ~ item.kind) }}
            </Fact>
            <Fact :label="_('web.admin.store.fact.requires')" plain>
              {{ row.requires }}
            </Fact>
            <Fact :label="_('web.admin.store.fact.rule')" plain>
              {{ rule }}
            </Fact>
          </dl>
          {% if row.prices.unsold %}
            <p class="bar-text prices-unsold">
              <span aria-hidden="true" class="badge"><Icon name="lock" :size="14" stroke="#0A0A0A" /></span><span>{{ row.ways }} · {{ _("web.admin.store.unsold.text." ~ row.prices.unsold.value) }}</span>
            </p>
          {% endif %}
        </section>

        {% if editable %}
          <form method="post" action="{{ here }}" class="prices-form">
            <CsrfField />
        {% endif %}
        <section aria-labelledby="prices-points" class="account-part">
          {% if editable %}
            <label class="check-row prices-off-row">
              <span class="prices-off-text">
                <span class="prices-off-title">{{ _("web.admin.store.not_sold") }}</span>
                <span>{{ _("web.admin.store.not_sold.text" if row.prices.alone else "web.admin.store.not_sold.text.drops") }}</span>
              </span>
              <span class="check-place">
                <input type="checkbox"
                       name="unsold"
                       value="1"
                       {% if unsold %} checked{% endif %}
                       class="check">
                <span aria-hidden="true" class="check-box"><Icon name="tick" stroke="currentColor" /></span></span>
            </label>
          {% endif %}
          <Bar id="prices-points" :extra="_n('web.admin.store.points.own', lines|selectattr('own')|list|length, total=number(lines|length))">{{ _("web.admin.store.points") }}</Bar>
          {% if lines %}
            <div class="table-scroll">
              <div role="table"
                   aria-labelledby="prices-points"
                   class="table prices-points-table">
                <div role="rowgroup">
                  <div role="row" class="prices-point-columns">
                    <div role="columnheader" class="column-head">{{ _("web.admin.store.point.column.product") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.store.point.column.currency") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.store.point.column.ownership") }}</div>
                    <div role="columnheader"
                         class="column-head column-number">{{ _("web.admin.store.point.column.price") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.store.point.column.from") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.store.point.column.sold") }}</div>
                  </div>
                </div>
                <div role="rowgroup" class="enter-rows table-rows">
                  {% for line in lines %}
                    {% set product = line.product %}
                    {% set ownership = product.ownership %}
                    {% set field = "price-" ~ product.id %}
                    {% set sold = saving.get("sold-" ~ product.id) if saving else product.published %}
                    {% set wrong = refused_point == product.id %}
                    <div role="row" class="prices-point-columns prices-point-row">
                      <div role="cell" class="admin-cell prices-product">{{ game.store.product_id(product.id) }}</div>
                      <div role="cell" class="admin-cell prices-currency">
                        <span aria-hidden="true"
                              class="cell-label">{{ _("web.admin.store.point.column.currency") }}</span>
                        {{ _("games." ~ game.id ~ ".currency." ~ product.currency) }}
                      </div>
                      <div role="cell" class="admin-cell">
                        <span aria-hidden="true"
                              class="cell-label">{{ _("web.admin.store.point.column.ownership") }}</span>
                        {% if fixed %}
                          {{ _("web.admin.store.step", step=number(levels.index(product.item_id) + 1), steps=number(levels|length)) }}
                        {% elif ownership.type == "tlmd" %}
                          {{ _n("web.store.price.days", ownership.days) }}
                        {% elif ownership.type == "lmct" %}
                          {{ _n("web.store.price.uses", ownership.uses) }}
                        {% else %}
                          {{ _("web.store.price.permanent") }}
                        {% endif %}
                      </div>
                      <div role="cell" class="admin-cell prices-price">
                        {% if editable %}
                          <input id="{{ field }}"
                                 name="{{ field }}"
                                 type="text"
                                 inputmode="numeric"
                                 value="{{ saving.get(field, product.price) }}"
                                 maxlength="13"
                                 required
                                 aria-label="{{ _('web.admin.store.point.price_of', currency=_('games.' ~ game.id ~ '.currency.' ~ product.currency), point=game.store.product_id(product.id)) }}"
                                 {% if wrong %} aria-invalid="true" aria-describedby="prices-why"{% endif %}
                                 class="field-input prices-price-input{% if wrong %} field-invalid{% endif %}">
                        {% else %}
                          {{ number(product.price) }}
                        {% endif %}
                      </div>
                      <div role="cell" class="admin-cell cell-stack">
                        <span aria-hidden="true" class="cell-label">{{ _("web.admin.store.point.column.from") }}</span>
                        {% if fixed %}
                          <span class="prices-from">{{ _("web.admin.store.state.fixed") }}</span>
                        {% elif line.own %}
                          <span class="prices-from">{{ _("web.admin.store.point.own") }}</span>
                          <span class="cell-ago">{{ _("web.admin.store.point.rule_value", price=number(line.rule)) if line.rule else _("web.admin.store.point.no_rule") }}</span>
                        {% else %}
                          <span class="prices-from">{{ _("web.admin.store.point.rule") }}</span>
                        {% endif %}
                      </div>
                      {% if editable %}
                        <div role="cell" class="admin-cell prices-state">
                          <label class="prices-sold">
                            <span class="check-place">
                              <input type="checkbox"
                                     name="sold-{{ product.id }}"
                                     value="1"
                                     {% if sold %} checked{% endif %}
                                     class="check">
                              <span aria-hidden="true"
                                    class="check-box"><Icon name="tick" stroke="currentColor" /></span></span>
                            {{ _("web.admin.store.point.on") }}
                          </label>
                        </div>
                      {% else %}
                        <div role="cell" class="admin-cell prices-state">
                          <Badge :name="'tick' if product.published else 'x'" lines />{{ _("web.admin.store.point.on" if product.published else "web.admin.store.point.off") }}
                        </div>
                      {% endif %}
                    </div>
                    {% if wrong %}
                      <div role="row">
                        <div role="cell" aria-colspan="6" id="prices-why">{{ refusal(why) }}</div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% else %}
            <p class="bar-text body-text">{{ _("web.admin.store.points.empty") }}</p>
          {% endif %}
          {% if fixed %}
            <p class="bar-text body-text">{{ _("web.admin.store.ability") }}</p>
          {% elif not manages %}
            <p class="bar-text account-role-note">
              <span aria-hidden="true"
                    class="badge"><Icon name="guard" :size="14" fill="#0A0A0A" /></span>{{ _("web.admin.store.managed") }}
            </p>
          {% endif %}
        </section>
        {% if editable %}
          <div class="prices-actions">
            <div class="prices-save">
              <p class="body-text">{{ _("web.admin.store.save.note") }}</p>
              <SmallAction :label="_('web.admin.store.save')" :busy="_('web.admin.store.save.busy')" />
            </div>
            <details class="prices-add"
                     {% if refused and refused_point is none %} open{% endif %}>
              <summary class="form-button">
                <span aria-hidden="true"
                      class="form-glyph"><Icon name="plus" :size="14" stroke="#F4F4EE" /></span>{{ _("web.admin.store.point.add") }}
              </summary>
              <div class="prices-add-panel">
                <fieldset class="prices-add-part">
                  <legend class="field-label">{{ _("web.admin.store.point.column.currency") }}</legend>
                  <div class="prices-picks">
                    {% for code in adding.currencies %}
                      <label class="prices-filter-pick">
                        <input type="radio"
                               name="add-currency"
                               form="prices-add"
                               value="{{ code }}"
                               {% if form.get("add-currency", adding.currencies[0]) == code %} checked{% endif %}
                               class="choice-input">
                        <span>{{ _("games." ~ game.id ~ ".currency." ~ code) }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </fieldset>
                <fieldset class="prices-add-part">
                  <legend class="field-label">{{ _("web.admin.store.point.column.ownership") }}</legend>
                  {% if adding.uses %}
                    <input name="add-uses"
                           form="prices-add"
                           type="text"
                           inputmode="numeric"
                           value="{{ form.get('add-uses', '') }}"
                           maxlength="10"
                           aria-label="{{ _('web.admin.store.point.uses') }}"
                           placeholder="{{ _('web.admin.store.point.uses') }}"
                           class="field-input">
                  {% else %}
                    <div class="prices-picks">
                      {% for written in adding.ownerships %}
                        <label class="prices-filter-pick">
                          <input type="radio"
                                 name="add-ownership"
                                 form="prices-add"
                                 value="{{ written }}"
                                 {% if form.get("add-ownership", adding.ownerships[0]) == written %} checked{% endif %}
                                 class="choice-input">
                          <span>{{ _("web.store.price.permanent") if written == "perm" else _n("web.store.price.days", written[:-1]|int) }}</span>
                        </label>
                      {% endfor %}
                    </div>
                  {% endif %}
                </fieldset>
                <label for="add-price" class="field-label">{{ _("web.admin.store.point.column.price") }}</label>
                <input id="add-price"
                       name="add-price"
                       form="prices-add"
                       type="text"
                       inputmode="numeric"
                       value="{{ form.get('add-price', '') }}"
                       maxlength="13"
                       placeholder="{{ _('web.admin.store.point.add.rule') }}"
                       class="field-input">
                {% if refused and refused_point is none %}{{ refusal(why) }}{% endif %}
                <FormButton icon="plus" form="prices-add">{{ _("web.admin.store.point.add.submit") }}</FormButton>
              </div>
            </details>
            <FormButton icon="retry" :formaction="here ~ '/reset'">{{ _("web.admin.store.reset") }}</FormButton>
          </div>
          </form>
          <form id="prices-add" method="post" action="{{ here }}/add">
            <CsrfField />
          </form>
        {% endif %}
      </div>
      <div class="list-side admin-side">
        <section aria-labelledby="prices-item-note">
          <Bar id="prices-item-note">{{ _("web.admin.store.keep.title") }}</Bar>
          <p class="bar-text body-text">{{ _("web.admin.store.keep_products") }}</p>
        </section>
      </div>
    </div>
  </Panel>
</AdminPage>

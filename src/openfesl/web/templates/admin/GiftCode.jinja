{#def of, entry, state, contents: list, made, codes: list, more: int, redemptions: list, link: str, manages: bool #}
{# A code that gives a gift on a game's site, or a batch of personal codes: its contents,
   accounts, end, labels, who made it and its one-click link, Disable or Enable and Edit for
   admins, for a batch its first codes with the download of them all, and the redemptions with
   what each gave. Moderators read it in full. #}
{% set game = of %}
{% set title = _("web.admin.keys") %}
{% set base = url("/admin/keys/codes/" ~ entry.code) %}
{% set label = entry.label(language) %}
{% set others = entry.labels.items()|rejectattr(0, "equalto", "en")|map(attribute=1)|list %}
{% set most = entry.count if entry.batch else entry.max_uses %}
{% set end = _("web.store.utc", time=moment(entry.expires)) if entry.expires else "" %}
{% set glyphs = {"enabled": "tick", "used_up": "full", "expired": "clock", "disabled": "x"} %}
<AdminPage :title="(label or entry.code) ~ ' · ' ~ title" current="keys">
  <PageHead labelledby="code-title"
            :title="title"
            :subtitle="_('web.admin.keys.subtitle.batch' if entry.batch else 'web.admin.keys.subtitle.code', game=game.name)" />
  <Panel class="enter-panel">
    <PanelBack :href="url('/admin/keys') ~ '?game=' ~ game.id" :label="_('web.admin.keys.all_codes')" />
    <h2 class="bar bar-wrap code-head">
      <span class="code-head-name">
        {% if entry.batch %}
          <span class="code-head-code">{{ _("web.admin.keys.batch_row", count=number(entry.count)) }}</span>
        {% else %}
          <code class="code-head-code">{{ entry.code }}</code>
        {% endif %}
        {{ label }}
      </span>
      <span class="code-state code-state-{{ state }}"><Icon :name="glyphs[state]" :size="14" stroke="currentColor" />{{ _("web.admin.keys.state." ~ state) }}</span>
    </h2>
    <div class="code-layout">
      <dl class="facts code-facts">
        <Fact :label="_('web.admin.keys.col.contents')" plain>
          {{ contents|join(" · ") or _("web.admin.audit.nothing") }}
        </Fact>
        <Fact :label="_('web.admin.keys.fact.accounts')" plain>
          {%- set kind = "batch" if entry.batch else ("most" if most is not none else "any") -%}
          {{ _("web.admin.keys.fact.used." ~ kind, used=number(entry.uses), most=number(most or 0)) }}
        </Fact>
        <Fact :label="_('web.admin.keys.col.ends')" plain>
          {%- if not end %}{{ _("web.admin.keys.no_end") }}{% elif state == "expired" %}{{ _("web.admin.keys.ended", time=end) }}{% else %}{{ end }}{% endif -%}
        </Fact>
        <Fact :label="_('web.admin.keys.labels')" plain>
          {{ ([entry.labels.get('en', '')] + others)|join(" · ") }}
        </Fact>
        {% if made %}
          <Fact :label="_('web.admin.keys.made')" plain>
            {{ _("web.admin.keys.made.by", date=when(made.at, "yMMMd"), name=made.by or _("web.admin.command_line"), note=made.note) }}
          </Fact>
        {% endif %}
        {% if not entry.batch %}
          <Fact :label="_('web.admin.keys.link')" plain>
            <a href="{{ url(link) }}" class="code-link">{{ link }}</a>
          </Fact>
        {% endif %}
      </dl>
      <div class="code-actions">
        {% if manages %}
          <FormButton :icon="'tick' if not entry.enabled else 'x'" :href="base ~ '/state'" dialog>{{ _("web.admin.keys.enable" if not entry.enabled else "web.admin.keys.disable") }}</FormButton>
          <FormButton icon="edit" :href="base ~ '/edit'">{{ _("web.admin.keys.edit") }}</FormButton>
          <p class="bar-text body-text">{{ _("web.admin.keys.edit.rule") }}</p>
        {% else %}
          <RoleNote glyph="lock" lines>{{ _("web.admin.keys.moderator") }}</RoleNote>
        {% endif %}
      </div>
    </div>
    {% if entry.batch %}
      <section aria-labelledby="batch-codes" class="code-batch-part">
        <Bar id="batch-codes" :extra="number(entry.count)">{{ _("web.admin.keys.batch_codes") }}</Bar>
        <p class="bar-text body-text">{{ _("web.admin.keys.batch.text") }}</p>
        <ol class="code-list">
          {% for code in codes %}<li><code>{{ code }}</code></li>{% endfor %}
          {% if more %}<li class="code-list-more">{{ _("web.admin.keys.batch.more", count=number(more)) }}</li>{% endif %}
        </ol>
        <Action :href="base ~ '/codes.txt'" :label="_('web.admin.keys.download')" glyph="download" download />
      </section>
    {% endif %}
    <section aria-labelledby="code-redemptions" class="code-batch-part">
      <Bar id="code-redemptions" :extra="_('web.admin.keys.redemptions.count', used=number(entry.uses))">{{ _("web.admin.keys.redemptions") }}</Bar>
      {% if redemptions %}
        <div class="table-scroll table-scroll-flush">
          <div role="table"
               aria-labelledby="code-redemptions"
               class="table code-redemptions">
            {% for done, given in redemptions %}
              <div role="row" class="code-redemption">
                <a role="cell"
                   href="{{ url('/admin/accounts/' ~ done.account_id) }}"
                   class="code-account">{{ done.account }}</a>
                <span role="cell">{{ done.hero or "–" }}</span>
                <span role="cell">{{ _("web.store.utc", time=moment(done.at)) }}</span>
                <span role="cell">
                  {%- if entry.batch %}<code class="code-text">{{ done.code }}</code> · {% endif %}{{ given -}}
                </span>
              </div>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <p class="bar-text body-text">{{ _("web.admin.keys.redemptions.none") }}</p>
      {% endif %}
    </section>
  </Panel>
</AdminPage>

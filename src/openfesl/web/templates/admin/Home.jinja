{#def online: int, logged_in: int, hosting: int, accounts: int, new_accounts: int, mode: str, waiting: list, warnings: list, flags: list, short: list, paused: list #}
{% set title = _("web.admin.home") %}
<AdminPage :title="title" current="home">
  <LiveArea>
    <PageHead labelledby="home-title"
              :title="title"
              :subtitle="_('web.admin.home.subtitle')">
      <div class="home-numbers">
        <p>{{ _n("web.shell.online", online) }} · {{ _n("web.admin.home.hosting", hosting) }}</p>
        <p>
          {{ _n("web.admin.home.sessions", logged_in) }} · {{ _n("web.admin.home.accounts", accounts, new=number(new_accounts)) }} · <Updated inline />
        </p>
      </div>
    </PageHead>
    <Panel class="enter-panel">
      <div class="home-columns">
        <div class="home-decisions">
          {% if waiting %}
            <section aria-labelledby="home-waiting">
              <Bar id="home-waiting" :extra="number(waiting|length)" large>{{ _("web.admin.waiting") }}</Bar>
              <div class="table-scroll">
                <div role="table" aria-labelledby="home-waiting" class="table waiting">
                  <div role="rowgroup" class="waiting-head">
                    <div role="row" class="waiting-columns">
                      <div role="columnheader"
                           class="column-head"><span class="sr-only">{{ _("web.servers.status") }}</span></div>
                      <div role="columnheader" class="column-head column-name">{{ _("web.servers.name") }}</div>
                      <div role="columnheader" class="column-head">{{ _("web.admin.provider") }}</div>
                      <div role="columnheader" class="column-head">{{ _("web.admin.tried") }}</div>
                      <div role="columnheader"
                           aria-sort="descending"
                           class="column-head column-sorted">
                        {{ _("web.admin.seen") }}<Icon name="down" :size="14" stroke="currentColor" />
                      </div>
                      <div role="columnheader"
                           class="column-head"><span class="sr-only">{{ _("web.admin.decision") }}</span></div>
                      <div role="columnheader"><span class="sr-only">{{ _("web.servers.page") }}</span></div>
                    </div>
                  </div>
                  <div role="rowgroup" data-rows class="enter-rows table-rows">
                    {% for view in waiting %}
                      {% set server = view.server %}
                      {% set href = url("/admin/servers/" ~ server.ugid) %}
                      <div role="row"
                           data-key="{{ server.ugid }}"
                           class="waiting-columns waiting-row">
                        <div role="cell" class="waiting-status">
                          <StateBadges :view="view" />
                        </div>
                        <div role="cell" class="waiting-name">
                          <a href="{{ href }}" class="server-name">{{ server.name }}</a>
                          {% if view.game %}<GameChip :of="view.game" />{% endif %}
                        </div>
                        <div role="cell" class="waiting-stack waiting-provider">
                          <ProviderName :view="view" />
                        </div>
                        <div role="cell" class="waiting-stack waiting-tried">
                          {% if view.hosting %}
                            <span><Published kind="map" :label="view.hosting.map" :of="view.game" /></span>
                            <span><Published kind="mode" :label="view.hosting.mode" :of="view.game" /></span>
                          {% else %}
                            <span aria-hidden="true">–</span><span class="sr-only">{{ _("web.admin.tried.none") }}</span>
                          {% endif %}
                        </div>
                        <div role="cell" class="waiting-stack waiting-seen">
                          <span>{{ _("web.server.time", time=when(server.first_seen, "Hm")) }}</span>
                          <span>{{ ago(server.first_seen) }}</span>
                        </div>
                        <div role="cell" class="waiting-decide">
                          {% if not view.provider_unknown %}
                            <form method="post"
                                  action="{{ url('/admin/servers/' ~ server.ugid ~ '/approve') }}">
                              <CsrfField />
                              <input type="hidden" name="back" value="{{ here }}">
                              <SmallAction :label="_('web.admin.approve')" :name="_('web.admin.approve.of', name=server.name)" :busy="_('web.admin.approve.busy')" />
                            </form>
                          {% else %}
                            <SmallAction :href="url('/admin/servers/' ~ server.ugid ~ '/approve') ~ '?back=' ~ here|urlencode" :label="_('web.admin.approve')" :name="_('web.admin.approve.confirmed', name=server.name)" dialog />
                          {% endif %}
                        </div>
                        <div role="cell" class="cell-end">
                          <EndSquare :href="href" :label="_('web.admin.server.page.of', name=server.name)" />
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
              <div class="list-foot">
                <p>
                  <span class="list-count">{{ _("web.admin.waiting.count", count=number(waiting|length)) }}</span><span class="list-range">{{ _("web.admin.waiting.note" if waiting|selectattr("reports_provider")|list else "web.admin.servers.order.waiting") }}</span>
                </p>
                <a href="{{ url('/admin/servers') }}"
                   class="home-more">{{ _("web.admin.details_link") }}<Icon name="go" :size="14" stroke="currentColor" /></a>
              </div>
            </section>
          {% elif not (warnings or flags or short or paused) %}
            <div class="home-calm">
              <Alert :label="_('web.admin.calm.label', count=number(0))" :title="_('web.admin.calm.title')">{{ _("web.admin.calm.text") }}</Alert>
              <div class="row-actions">
                <SmallAction :href="url('/admin/servers?state=approved')" :label="_('web.admin.servers.approved_link')" />
                <FormButton icon="go" :href="url('/admin/audit')">{{ _("web.admin.menu.audit") }}</FormButton>
              </div>
            </div>
          {% endif %}
        </div>
        <div class="home-side">
          {% if warnings %}
            <section aria-labelledby="home-warnings">
              <Bar id="home-warnings" :extra="number(warnings|length)" large>{{ _("web.admin.warnings") }}</Bar>
              {% for view in warnings %}
                <div class="warning">
                  <p class="alert-label">
                    <span aria-hidden="true" class="alert-glyph"><Icon name="x" stroke="#0A0A0A" /></span>{{ _n("web.admin.warning.refused", view.attempts.refused_today) }}
                  </p>
                  <ServerTitle :name="view.server.name" :game="view.game" />
                  <p class="body-text">{{ _("web.admin.warning.text") }}</p>
                </div>
                <dl class="facts">
                  <Fact :label="_('web.admin.warning.last')">
                    {{ _("web.server.time", time=when(view.attempts.last, "Hm")) }}
                  </Fact>
                  {% if view.decision %}
                    <Fact :label="_('web.admin.warning.revoked')">
                      {{ _("web.server.time", time=moment(view.decision.at, "MMMd")) }}
                    </Fact>
                    <Fact :label="_('web.admin.warning.by')" plain>
                      {{ view.decision.admin or _("web.admin.command_line") }}
                    </Fact>
                  {% endif %}
                </dl>
                <FormButton icon="go" :href="url('/admin/servers/' ~ view.server.ugid)">{{ _("web.admin.open", name=view.server.name) }}</FormButton>
              {% endfor %}
            </section>
          {% endif %}
          {% if flags or short %}
            <section aria-labelledby="home-store">
              <Bar id="home-store" :extra="number(flags|length + short|length)" large>{{ _("web.admin.home.store") }}</Bar>
              {% for game, row in short %}
                <div class="warning">
                  <p class="alert-label">
                    <span aria-hidden="true"
                          class="alert-glyph"><Icon name="warn" fill="#0A0A0A" /></span>{{ _("web.admin.home.warning.deals") }}
                  </p>
                  <p class="body-text">
                    {{ _("web.admin.home.warning.deals.text", section=_("games." ~ game.id ~ ".deal_section." ~ row.key), size=number(row.section.size)) }}
                  </p>
                </div>
                <FormButton icon="go" :href="url('/admin/store/' ~ game.id ~ '/deals?section=' ~ row.key)">{{ _("web.admin.open", name=_("games." ~ game.id ~ ".deal_section." ~ row.key)) }}</FormButton>
              {% endfor %}
              {% for flag in flags %}
                <div class="warning">
                  <p class="alert-label">
                    <span aria-hidden="true"
                          class="alert-glyph"><Icon name="warn" fill="#0A0A0A" /></span>{{ _("web.admin.home.warning.boxes") }}
                  </p>
                  <p class="body-text">
                    {{ _("web.admin.home.warning.boxes.text", box=flag.row.name, item=flag.item, value=number(flag.product.price), price=number(flag.row.box.value)) }}
                  </p>
                </div>
                <FormButton icon="go" :href="url('/admin/store/' ~ flag.game.id ~ '/boxes/' ~ flag.row.box.id)">{{ _("web.admin.open", name=flag.row.name) }}</FormButton>
              {% endfor %}
            </section>
          {% endif %}
          {% if paused %}
            <section aria-labelledby="home-rewards">
              <Bar id="home-rewards" :extra="number(paused|length)" large>{{ _("web.admin.menu.rewards") }}</Bar>
              {% for game, entry in paused %}
                {% set page = _("web.admin.rewards.subtitle", game=game.name) %}
                <div class="warning">
                  <p class="alert-label">
                    <span aria-hidden="true"
                          class="alert-glyph"><Icon name="pause" stroke="#0A0A0A" /></span>{{ _("web.admin.rewards.pause") }}
                  </p>
                  <p class="body-text">
                    {{ _("web.admin.home.warning.rewards", page=page, time=moment(entry.at), admin=entry.name or _("web.admin.command_line"), note=entry.details.note) if entry else _("web.admin.home.warning.rewards.settings", page=page) }}
                  </p>
                </div>
                <FormButton icon="go" :href="url('/admin/rewards/' ~ game.id)">{{ _("web.admin.open", name=_("web.admin.menu.rewards")) }}</FormButton>
              {% endfor %}
            </section>
          {% endif %}
          <HostingMode :mode="mode" />
        </div>
      </div>
    </Panel>
  </LiveArea>
</AdminPage>

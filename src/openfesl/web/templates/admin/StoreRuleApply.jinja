{#def of, key: str, outcome, example: str, fields: dict #}
{# The question before a changed price rule applies: how many items without prices of their
   own take its prices now, how many keep their own, an item as it will be sold, and what the
   change leaves as it is. #}
{% set game = of %}
{% set name = _("games." ~ game.id ~ ".price_rule." ~ key) %}
{% set back = url("/admin/store/" ~ game.id ~ "/rules?rule=" ~ key) %}
<StorePage :game="game"
           :title="_('web.admin.store.view.rules') ~ ' · ' ~ _('web.admin.store.title')"
           current="prices"
           :subtitle="_('web.admin.store.subtitle', game=game.name)"
           frame="confirm-frame">
  <Confirmation :question="_('web.admin.store.rules.confirm', rule=name)"
                :action="url('/admin/store/' ~ game.id ~ '/rules/' ~ key ~ '/apply')"
                :label="_n('web.admin.store.rules.confirm.submit', outcome.changed)"
                :busy="_('web.admin.store.rules.confirm.busy')"
                :back="back"
                :hidden="fields">
    <dl class="facts">
      <Fact :label="_('web.admin.store.rules.confirm.change')" plain>
        {{ _n("web.admin.store.rules.confirm.changed", outcome.changed) }}
      </Fact>
      <Fact :label="_('web.admin.store.rules.confirm.keep')" plain>
        {{ _n("web.admin.store.rules.confirm.kept", outcome.kept) }}
      </Fact>
      {% if example %}
        <Fact :label="_('web.admin.store.rules.confirm.example')" plain>
          {{ example }}
        </Fact>
      {% endif %}
    </dl>
    <p id="confirm-text" class="body-text">{{ _("web.admin.store.rules.confirm.text") }}</p>
  </Confirmation>
</StorePage>

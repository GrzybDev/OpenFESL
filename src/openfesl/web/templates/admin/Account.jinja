{#def view, entitlements: list, active: int, changes, remembered: list, total: int, terms: str, manages: bool #}
{# A player's account: what is kept about it, its in-game names and entitlements, beside the search,
   the session it is logged in on and the logins its game remembers. #}
{% set record = view.record %}
{% set account = record.account %}
{% set title = _("web.admin.account") %}
{% set base = url("/admin/accounts/" ~ account.id) %}
{% set session = view.session %}
{% set playing = view.playing %}
{% set revoked = entitlements|length - active %}
{% macro badge(glyph) %}
  <span aria-hidden="true" class="badge"><Icon :name="glyph" stroke="#0A0A0A" fill="#0A0A0A" /></span>
{% endmacro %}
<AdminPage :title="title ~ ' · ' ~ account.nuid" current="accounts">
  <PageHead labelledby="account-title">
    <div class="enter-title page-title page-title-wider">
      <h1 id="account-title" class="account-heading">
        <span class="title-block">{{ title }}</span>
        <span class="title-sub account-heading-name">{{ account.nuid }}</span>
      </h1>
    </div>
    <Tab :href="url('/admin/accounts')" class="tab-back tab-link"><Icon name="go" :size="14" stroke="currentColor" class="go" />{{ _("web.admin.accounts.all") }}<span class="tab-count">{{ number(total) }}</span></Tab>
  </PageHead>
  <Panel class="enter-panel">
    <div class="list-layout admin-layout">
      <div class="list-main account-main">
        <section aria-labelledby="account-facts">
          <div class="account-bar">
            <h2 id="account-facts">{{ _("web.admin.account.number", number=account.id) }}</h2>
            <p>{{ _("web.admin.account.kind") }}</p>
          </div>
          <dl class="facts admin-facts account-facts">
            <Fact :label="_('web.admin.account.login')" plain>
              <span class="account-login">{{ account.nuid }}</span>
            </Fact>
            <Fact :label="_('web.admin.account.country')">
              {% if account.country %}
                <span class="country-code">{{ account.country }}</span>{{ country(account.country) }}
              {% else %}
                {{ _("web.admin.account.country.none") }}
              {% endif %}
            </Fact>
            <Fact :label="_('web.admin.account.created')">
              {{ _("web.server.time", time=moment(record.created)) }}
            </Fact>
            <Fact :label="_('web.admin.account.terms')">
              {{ _("web.admin.account.terms." ~ ("current" if account.terms_version == terms else "older" if account.terms_version else "none")) }}
            </Fact>
            <Fact :label="_('web.admin.account.last_login')">
              {{ _("web.server.time", time=moment(record.last_login)) if record.last_login else _("web.admin.account.never") }}
            </Fact>
            <Fact :label="_('web.admin.account.now')">
              {{ _("web.admin.account.online.session") if session else _("web.admin.account.offline") }}
            </Fact>
            <Fact :label="_('web.admin.state')">
              {% if account.login_error() is none %}
                {{ _("web.admin.account.state.active") }}
              {% elif account.state_until %}
                {{ _("web.admin.account.state.until_time", state=_("web.admin.account.state." ~ account.state), time=_("web.server.time", time=moment(account.state_until))) }}
              {% else %}
                {{ _("web.admin.account.state." ~ account.state) }}
              {% endif %}
            </Fact>
            {% if account.verification_expires_at %}
              <Fact :label="_('web.admin.account.email')">
                {{ _("web.admin.account.email.waiting") }}
              </Fact>
            {% endif %}
          </dl>
          <div class="account-decide">
            <FormButton icon="lock" :href="base ~ '/state'" dialog>{{ _("web.admin.account.state.change") }}</FormButton>
            {% if account.verification_expires_at %}
              <form method="post" action="{{ base }}/verify">
                <CsrfField />
                <FormButton icon="tick">{{ _("web.admin.account.verify") }}</FormButton>
              </form>
            {% endif %}
          </div>
          {% if account.verification_expires_at %}
            <p class="body-text side-note">{{ _("web.admin.account.verify.note") }}</p>
          {% endif %}
        </section>

        <section aria-labelledby="account-names" class="account-part">
          <Bar id="account-names" :extra="number(view.personas|length)">{{ _("web.admin.account.names") }}</Bar>
          {% if view.personas %}
            <ul class="account-list">
              {% for persona in view.personas %}
                {% set entry = persona.record %}
                <li>
                  {{ badge("tick" if persona.usable else "x") }}
                  {% if persona.usable and persona.game %}
                    <a href="{{ url('/' ~ persona.game.id ~ '/players/' ~ entry.persona.name|urlencode) }}"
                       class="account-name-link">{{ entry.persona.name }}</a>
                  {% else %}
                    <span class="account-name-text">{{ entry.persona.name }}</span>
                  {% endif %}
                  {% if persona.game %}<GameChip :of="persona.game" />{% endif %}
                  <span class="account-list-when">{{ _("web.admin.persona.created", time=_("web.server.time", time=moment(entry.created))) }}</span>
                  <span class="account-list-state">
                    {% if entry.removed %}
                      {{ _("web.admin.persona.removed", day=when(entry.removed, "yMMMd")) }}
                    {% elif entry.state == "disabled" %}
                      {{ _("web.admin.persona.state.disabled") }}
                    {% elif persona.server %}
                      {{ _("web.admin.account.on", server=persona.server.name) }}
                    {% elif persona.playing %}
                      {{ _("web.admin.account.menus") }}
                    {% else %}
                      {{ _("web.admin.persona.active") }}
                    {% endif %}
                  </span>
                  {% if not entry.removed %}
                    {% set name_base = base ~ "/names/" ~ entry.persona.id %}
                    <span class="account-list-actions">
                      {% if persona.server %}
                        <a href="{{ name_base }}/kick?back={{ here|urlencode }}"
                           data-dialog
                           aria-haspopup="dialog"
                           aria-label="{{ _('web.admin.account.kick.of', name=entry.persona.name) }}"
                           class="list-button">{{ _("web.admin.account.kick") }}</a>
                      {% endif %}
                      {% if entry.state == "disabled" %}
                        <form method="post" action="{{ name_base }}/enable">
                          <CsrfField />
                          <button type="submit"
                                  aria-label="{{ _('web.admin.account.enable.of', name=entry.persona.name) }}"
                                  class="list-button">{{ _("web.admin.account.enable") }}</button>
                        </form>
                      {% else %}
                        <a href="{{ name_base }}/disable?back={{ here|urlencode }}"
                           data-dialog
                           aria-haspopup="dialog"
                           aria-label="{{ _('web.admin.account.disable.of', name=entry.persona.name) }}"
                           class="list-button">{{ _("web.admin.account.disable") }}</a>
                      {% endif %}
                    </span>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="bar-text body-text">{{ _("web.admin.account.names.none") }}</p>
          {% endif %}
          <p class="body-text side-note">{{ _("web.admin.account.names.note") }} {{ _("web.admin.account.names.decide") }}</p>
        </section>

        <section aria-labelledby="account-entitlements" class="account-part">
          <Bar id="account-entitlements" :extra="_('web.admin.entitlements.summary', active=number(active), revoked=number(revoked)) if revoked else _n('web.admin.entitlements.active', active)">{{ _("web.admin.entitlements") }}</Bar>
          {% if entitlements %}
            <div class="table-scroll">
              <div role="table"
                   aria-labelledby="account-entitlements"
                   class="table entitlements{% if manages %} entitlements-managed{% endif %}">
                <div role="rowgroup">
                  <div role="row" class="entitlement-columns">
                    <div role="columnheader"
                         class="column-head"><span class="sr-only">{{ _("web.admin.state") }}</span></div>
                    <div role="columnheader" class="column-head column-name">{{ _("web.admin.entitlement.tag") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.entitlement.group") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.entitlement.product") }}</div>
                    <div role="columnheader" class="column-head">{{ _("web.admin.state") }}</div>
                    {% if manages %}
                      <div role="columnheader"
                           class="column-head"><span class="sr-only">{{ _("web.admin.decision") }}</span></div>
                    {% endif %}
                  </div>
                </div>
                <div role="rowgroup" class="table-rows">
                  {% for entitlement in entitlements %}
                    {% set held = entitlement.status == "ACTIVE" %}
                    <div role="row" class="entitlement-columns entitlement-row">
                      <div role="cell" class="admin-cell admin-badges">{{ badge("tick" if held else "x") }}</div>
                      <div role="cell" class="admin-cell">
                        <code class="entitlement-code">{{ entitlement.tag }}</code>
                      </div>
                      <div role="cell" class="admin-cell">
                        <span aria-hidden="true" class="entitlement-label">{{ _("web.admin.entitlement.group") }}</span>
                        <code class="entitlement-code">{{ entitlement.group or "–" }}</code>
                      </div>
                      <div role="cell" class="admin-cell">
                        <span aria-hidden="true"
                              class="entitlement-label">{{ _("web.admin.entitlement.product") }}</span>
                        <code class="entitlement-code">{{ entitlement.product or "–" }}</code>
                      </div>
                      <div role="cell" class="admin-cell cell-stack">
                        {% set change = changes.get(entitlement.tag) %}
                        <span class="account-now">{{ _("web.admin.entitlement.active") if held else _("web.admin.entitlement.revoked") }}</span>
                        <span class="cell-ago">
                          {% if not held and change %}
                            {{ _("web.admin.entitlement.revoked_by", time=_("web.server.time", time=moment(change.at)), name=change.by or _("web.admin.command_line")) }}
                          {% else %}
                            {{ _("web.admin.entitlement.granted", day=when(entitlement.granted, "yMMMd")) }}
                          {% endif %}
                        </span>
                      </div>
                      {% if manages %}
                        <div role="cell" class="entitlement-decide">
                          {% if held %}
                            <a href="{{ base }}/entitlements/revoke?{{ {'tag': entitlement.tag, 'back': here}|urlencode }}"
                               data-dialog
                               aria-haspopup="dialog"
                               aria-label="{{ _('web.admin.entitlement.revoke.of', tag=entitlement.tag) }}"
                               class="form-button"><span aria-hidden="true" class="form-glyph"><Icon name="x" :size="14" stroke="#F4F4EE" /></span>{{ _("web.admin.entitlement.revoke") }}</a>
                          {% else %}
                            <form method="post" action="{{ base }}/entitlements/restore">
                              <CsrfField />
                              <input type="hidden" name="tag" value="{{ entitlement.tag }}">
                              <button type="submit"
                                      aria-label="{{ _('web.admin.entitlement.restore.of', tag=entitlement.tag) }}"
                                      class="form-button">
                                <span aria-hidden="true" class="form-glyph"><Icon name="tick" :size="14" stroke="#F4F4EE" /></span>{{ _("web.admin.entitlement.restore") }}
                              </button>
                            </form>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% else %}
            <p class="bar-text body-text">{{ _("web.admin.entitlements.none") }}</p>
          {% endif %}
          <div class="list-foot">
            <p>
              <span class="list-count">{{ _("web.admin.entitlements.count", count=number(entitlements|length)) }}</span><span class="list-range">{{ _("web.admin.entitlements.note") }}</span>
            </p>
            {% if manages %}
              <SmallAction :href="base ~ '/grant'" :label="_('web.admin.entitlements.grant')" dialog />
            {% endif %}
          </div>
          {% if not manages %}
            <p class="bar-text account-role-note">
              <span aria-hidden="true"
                    class="badge"><Icon name="guard" :size="14" fill="#0A0A0A" /></span>{{ _("web.admin.entitlements.managed") }}
            </p>
          {% endif %}
        </section>
      </div>

      <div class="list-side admin-side">
        <AccountSearch />

        <section aria-labelledby="account-sessions">
          <Bar id="account-sessions" :extra="number(1 if session else 0)">{{ _("web.admin.sessions") }}</Bar>
          {% if session %}
            <p class="bar-text account-session-name">
              {% if playing %}
                <span>{{ playing.record.persona.name }}</span>
                {% if playing.game %}<GameChip :of="playing.game" />{% endif %}
              {% else %}
                <span>{{ _("web.admin.session.no_name") }}</span>
              {% endif %}
            </p>
            <dl class="facts">
              <Fact :label="_('web.admin.session.client')">
                {{ _("web.admin.session.player") }}
                {% if session.client_string %}<code class="entitlement-code">{{ session.client_string }}</code>{% endif %}
              </Fact>
              <Fact :label="_('web.admin.session.connected')">
                {{ _("web.server.time", time=when(session.logged_in_at, "Hm")) }} · {{ ago(session.logged_in_at) }}
              </Fact>
              <Fact :label="_('web.admin.session.playing')" plain>
                {% if playing and playing.server and playing.server.ugid %}
                  <a href="{{ url('/admin/servers/' ~ playing.server.ugid) }}"
                     class="account-server">{{ playing.server.name }}</a>
                {% elif playing and playing.server %}
                  {{ playing.server.name }}
                {% else %}
                  {{ _("web.admin.account.menus") }}
                {% endif %}
              </Fact>
            </dl>
            <div class="account-end">
              <FormButton icon="x" :href="base ~ '/session/end?back=' ~ here|urlencode" dialog>{{ _("web.admin.account.end") }}</FormButton>
            </div>
            <p class="body-text side-note">{{ _("web.admin.sessions.note") }}</p>
          {% else %}
            <p class="bar-text body-text">{{ _("web.admin.sessions.none") }}</p>
          {% endif %}
        </section>

        <section aria-labelledby="account-remembered">
          <Bar id="account-remembered" :extra="number(remembered|length)">{{ _("web.admin.remembered") }}</Bar>
          {% if remembered %}
            <ul class="account-list account-remembered">
              {% for login in remembered %}
                <li>
                  <span class="cell-stack">
                    <span class="account-remembered-when">{{ _("web.admin.remembered.created", time=_("web.server.time", time=moment(login.created))) }}</span>
                    <span class="cell-ago">{{ ago(login.created) }}</span>
                  </span>
                  <form method="post" action="{{ base }}/remembered/remove">
                    <CsrfField />
                    <input type="hidden" name="login" value="{{ login.id }}">
                    <button type="submit"
                            aria-label="{{ _('web.admin.remembered.remove.of', time=_('web.server.time', time=moment(login.created))) }}"
                            class="list-button">{{ _("web.admin.remembered.remove") }}</button>
                  </form>
                </li>
              {% endfor %}
            </ul>
            <form method="post"
                  action="{{ base }}/remembered/remove"
                  class="account-end">
              <CsrfField />
              <FormButton icon="x">{{ _("web.admin.remembered.remove_all") }}</FormButton>
            </form>
          {% else %}
            <p class="bar-text body-text">{{ _("web.admin.remembered.none") }}</p>
          {% endif %}
          <p class="body-text side-note">{{ _("web.admin.remembered.note") }} {{ _("web.admin.remembered.note.removal") }}</p>
          <RowLink :href="url('/admin/audit?account=' ~ account.id)" :label="_('web.admin.audit.of_account')" />
        </section>
      </div>
    </div>
  </Panel>
</AdminPage>

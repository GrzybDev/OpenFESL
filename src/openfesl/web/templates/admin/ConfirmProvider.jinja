{#def view, file_name: str, back: str #}
{# The revocation of a provider, which asks first, as a page of its own: the provider, its servers
   and what revoking it does. Where scripts run, its panel opens as a dialog. #}
{% set provider = view.provider %}
{% set title = _("web.admin.providers") %}
{% set approved = view.servers|selectattr("tab", "equalto", "approved")|list %}
{% set waiting = view.servers|selectattr("tab", "equalto", "waiting")|map(attribute="server.name")|list %}
{% set total = view.servers|length %}
{% set official = view.servers|selectattr("server.official")|map(attribute="server.name")|list %}
<AdminPage :title="title" current="providers">
  <PageHead labelledby="confirm-title"
            :title="title"
            :subtitle="_('web.admin.providers.list.active')" />
  <Panel class="enter-panel confirm-frame">
    <Confirmation :question="_('web.admin.confirm.provider')"
                  :action="url('/admin/providers/' ~ provider.id.hex() ~ '/revoke')"
                  :label="_('web.admin.revoke.confirm')"
                  :busy="_('web.admin.provider.revoke.busy')"
                  :back="back"
                  glyph="x">
      <p class="server-title">{{ provider.name }}</p>
      <dl class="facts">
        <Fact :label="_('web.admin.provider_id')">
          <ProviderId :id="provider.id" />
        </Fact>
        <Fact :label="_('web.admin.column.approved')">
          <Badge name="tick" :size="14" lines />{{ _("web.admin.approved_count", count=number(approved|length), hosting=number(view.hosting|length)) }}
        </Fact>
        {% if waiting %}
          <Fact :label="_('web.admin.column.waiting')">
            <Badge name="clock" :size="14" lines />{{ _("web.admin.waiting_names", count=number(waiting|length), names=listed(waiting)) }}
          </Fact>
        {% endif %}
        <Fact :label="_('web.admin.players_on')">
          <span class="confirm-number">{{ number(view.players) }}</span>
        </Fact>
        {% if official %}
          <Fact :label="_('web.server.official')">
            <Badge name="star" :size="14" />{{ listed(official) }}
          </Fact>
        {% endif %}
      </dl>
      <p id="confirm-text" class="body-text">
        {{ _n("web.admin.confirm.provider.text", total, file=file_name) if total > 1 else _("web.admin.confirm.provider.text." ~ ("single" if total else "none"), file=file_name) }}
      </p>
      {% if official %}
        <ConfirmMark>{{ _n("web.admin.confirm.provider.official", official|length, names=listed(official)) }}</ConfirmMark>
      {% endif %}
    </Confirmation>
  </Panel>
</AdminPage>

msgid "verification.mail.subject"
msgstr "Confirm the e-mail address of an OpenFESL account"

#, python-brace-format
msgid "verification.mail.body"
msgstr ""
"An OpenFESL account was registered with this e-mail address. It can log in "
"once the address is confirmed with this link:\n"
"\n"
"{link}\n"
"\n"
"The link is valid until {expires}. After that, the next login from the game "
"sends a new link. An account whose address is not confirmed cannot log in; "
"nothing else needs to be done.\n"

msgid "verification.page.confirmed.heading"
msgstr "E-mail address confirmed"

msgid "verification.page.confirmed.text"
msgstr "The account can now log in from the game."

msgid "verification.page.expired.heading"
msgstr "Link expired"

msgid "verification.page.expired.text"
msgstr ""
"The next login from the game sends a new link to the account's e-mail "
"address."

msgid "verification.page.unknown.heading"
msgstr "Link not valid"

msgid "verification.page.unknown.text"
msgstr ""
"The link is not valid or has been used already. A confirmed address needs "
"nothing more."

